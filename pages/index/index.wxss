/* pages/index/index.wxss */

.poster-page {
  min-height: 100vh;
}

.poster-shell {
  display: flex;
  flex-direction: column;
  gap: 96rpx;
  padding-top: 52rpx;
  padding-bottom: 88rpx;
}

.poster-topline {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.poster-tags {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.poster-topside {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.tag-special {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-right: 28rpx;
}

.tag-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--neon-primary);
  box-shadow: 0 0 18rpx rgba(243, 154, 181, 0.42);
  animation: pulse 2.4s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.55; transform: scale(0.88); }
  50% { opacity: 1; transform: scale(1.18); }
}

.poster-city {
  padding-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  letter-spacing: 6rpx;
  color: var(--ink-tertiary);
  text-transform: uppercase;
  text-align: right;
}

.poster-kicker {
  font-size: 18rpx;
  letter-spacing: 8rpx;
  color: rgba(150, 136, 156, 0.72);
}

.poster-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 28rpx;
  padding: 36rpx 0 0;
}

.hero-nameplate {
  font-size: 54rpx;
  line-height: 1.18;
  font-weight: 600;
  letter-spacing: -1rpx;
  color: var(--ink-primary);
  text-shadow: 0 10rpx 28rpx rgba(255, 255, 255, 0.42);
}

.name-sep {
  display: inline-block;
  margin: 0 10rpx;
  color: rgba(125, 103, 120, 0.5);
}

.hero-statement {
  max-width: 560rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--ink-secondary);
  letter-spacing: 2rpx;
}

.hero-coverline {
  font-size: 22rpx;
  line-height: 1.6;
  letter-spacing: 5rpx;
  color: var(--ink-tertiary);
  text-transform: uppercase;
}

.hero-timer-wrap {
  width: 100%;
  max-width: 660rpx;
  margin-top: 28rpx;
}

.hero-timer-card {
  padding: 60rpx 44rpx 52rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
  overflow: hidden;
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(36rpx);
  opacity: 0.38;
  pointer-events: none;
  animation: hero-breathe 9s ease-in-out infinite alternate;
}

.hero-glow-a {
  width: 240rpx;
  height: 240rpx;
  top: -60rpx;
  left: -20rpx;
  background: rgba(243, 154, 181, 0.34);
}

.hero-glow-b {
  width: 220rpx;
  height: 220rpx;
  right: -30rpx;
  bottom: 40rpx;
  background: rgba(142, 202, 230, 0.24);
  animation-delay: -3s;
}

.hero-frame-lines {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  height: 1px;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.64) 20%, rgba(255, 255, 255, 0.3) 80%, transparent 100%);
  opacity: 0.62;
  pointer-events: none;
}

.hero-frame-top {
  top: 24rpx;
}

.hero-frame-bottom {
  bottom: 24rpx;
}

.hero-timer-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(115deg, transparent 18%, rgba(255, 255, 255, 0.42) 46%, transparent 72%);
  transform: translateX(-130%);
  animation: poster-sheen 9s ease-in-out infinite;
  pointer-events: none;
}

@keyframes poster-sheen {
  0%, 22% { transform: translateX(-130%); }
  52%, 100% { transform: translateX(130%); }
}

@keyframes hero-breathe {
  0% { transform: scale(0.92) translate3d(0, 0, 0); opacity: 0.22; }
  100% { transform: scale(1.08) translate3d(8rpx, -10rpx, 0); opacity: 0.42; }
}

.hero-timer-caption {
  position: relative;
  z-index: 1;
  font-size: 20rpx;
  letter-spacing: 8rpx;
  color: var(--ink-tertiary);
}

.hero-days-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 18rpx;
}

.hero-days {
  font-family: "Inter", "Times New Roman", serif;
  font-size: 208rpx;
  line-height: 0.88;
  font-weight: 900;
  letter-spacing: -8rpx;
  text-shadow: 0 18rpx 42rpx rgba(240, 187, 199, 0.24);
}

.hero-days-unit {
  padding-bottom: 20rpx;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 600;
  color: var(--ink-secondary);
}

.hero-subtime {
  position: relative;
  z-index: 1;
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  gap: 0;
  margin-top: 8rpx;
  padding: 24rpx 12rpx 0;
  border-top: 1px solid rgba(210, 190, 202, 0.24);
}

.hero-subtime-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.hero-subtime-divider {
  width: 1px;
  background: linear-gradient(180deg, transparent 0%, rgba(214, 195, 206, 0.42) 18%, rgba(214, 195, 206, 0.42) 82%, transparent 100%);
}

.sub-val {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--ink-primary);
  font-variant-numeric: tabular-nums;
}

.sub-lbl {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--ink-tertiary);
  letter-spacing: 2rpx;
}

.neon-pulse {
  text-shadow: 0 0 18rpx rgba(247, 199, 166, 0.44);
}

.hero-sidecopy {
  position: relative;
  z-index: 1;
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink-secondary);
}

.poster-lower {
  display: grid;
  grid-template-columns: minmax(0, 1.28fr) minmax(220rpx, 0.82fr);
  gap: 24rpx;
  align-items: start;
  margin-top: 12rpx;
}

.poster-quote-card {
  min-height: 100%;
  padding: 34rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.section-kicker {
  font-size: 20rpx;
  color: #c97b9a;
  letter-spacing: 4rpx;
}

.poster-quote {
  font-size: 32rpx;
  line-height: 1.78;
  color: var(--ink-primary);
}

.summary-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-start;
}

.btn-mini {
  height: 60rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
}

.poster-side-stack {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.compact-stat {
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.hero-stat {
  min-height: 182rpx;
  justify-content: center;
}

.stat-lbl {
  font-size: 20rpx;
  color: var(--ink-tertiary);
}

.stat-val {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink-primary);
}

.stat-desc {
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--ink-secondary);
}

.mini-notes-card {
  padding: 30rpx 28rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.compact-section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.small-title {
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 600;
  color: var(--ink-primary);
}

.section-count {
  padding-top: 6rpx;
  font-size: 24rpx;
  color: var(--ink-secondary);
}

.notes-preview-area {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.note-item {
  padding: 22rpx 0;
  border-top: 1px dashed rgba(208, 185, 198, 0.35);
}

.note-item:first-child {
  padding-top: 0;
  border-top: none;
}

.note-meta {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.note-author {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-primary);
}

.note-time {
  font-size: 22rpx;
  color: var(--ink-tertiary);
}

.note-content {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--ink-primary);
  white-space: pre-wrap;
}

.mini-empty {
  padding: 44rpx 28rpx;
  font-size: 26rpx;
}

.spot-actions {
  margin-top: 2rpx;
}

.neon-spark {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 0 14rpx rgba(243, 154, 181, 0.26), 0 0 30rpx rgba(142, 202, 230, 0.18);
  animation: driftUp 10s linear infinite;
  opacity: 0.45;
}

@keyframes driftUp {
  0% { transform: translateY(0) scale(0.9); opacity: 0; }
  18% { opacity: 0.72; }
  82% { opacity: 0.48; }
  100% { transform: translateY(-220rpx) scale(0.48); opacity: 0; }
}

.spark-one { left: 20%; top: 60%; animation-delay: 0s; }
.spark-two { left: 80%; top: 40%; animation-delay: 2s; }
.spark-three { left: 50%; top: 80%; animation-delay: 4s; }
.spark-four { left: 10%; top: 30%; animation-delay: 1s; }
.spark-five { left: 90%; top: 70%; animation-delay: 3s; }
.spark-six { left: 40%; top: 20%; animation-delay: 5s; }
