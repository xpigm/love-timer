/* pages/index/index.wxss */

.poster-page {
  min-height: 100vh;
}

.poster-shell {
  display: flex;
  flex-direction: column;
  gap: 104rpx;
  padding-top: 60rpx;
  padding-bottom: 88rpx;
}

.poster-topline {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.poster-tags {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.poster-topside {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.tag-special {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-right: 28rpx;
}

.tag-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--neon-primary);
  box-shadow: 0 0 30rpx rgba(243, 154, 181, 0.62), 0 0 44rpx rgba(243, 154, 181, 0.26);
  animation: pulse 1.6s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.6; transform: scale(0.84); }
  50% { opacity: 1; transform: scale(1.26); }
}

.poster-city {
  padding-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  letter-spacing: 4rpx;
  color: var(--ink-tertiary);
  text-transform: uppercase;
  text-align: right;
}

.poster-kicker {
  font-size: 18rpx;
  letter-spacing: 5rpx;
  color: var(--ink-tertiary);
}

.poster-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 30rpx;
  padding: 52rpx 0 34rpx;
}

.hero-nameplate {
  font-family: "Songti SC", "STSong", "PingFang SC", serif;
  font-size: 56rpx;
  line-height: 1.14;
  font-weight: 600;
  letter-spacing: -1.2rpx;
  color: var(--ink-primary);
  text-shadow: 0 10rpx 28rpx rgba(255, 255, 255, 0.42);
}

.name-sep {
  display: inline-block;
  margin: 0 10rpx;
  color: rgba(125, 103, 120, 0.5);
}

.hero-statement {
  max-width: 540rpx;
  font-size: 28rpx;
  line-height: 1.72;
  color: var(--ink-secondary);
  letter-spacing: 0.8rpx;
  text-shadow: 0 1rpx 0 rgba(255, 255, 255, 0.28);
}

.hero-coverline {
  font-size: 20rpx;
  line-height: 1.7;
  letter-spacing: 3rpx;
  color: var(--ink-tertiary);
  text-transform: uppercase;
}

.hero-timer-wrap {
  position: relative;
  width: 100%;
  max-width: 700rpx;
  margin-top: 34rpx;
  padding: 26rpx 18rpx 18rpx;
}

.hero-stage-wrap::before {
  content: "";
  position: absolute;
  left: 8%;
  right: 8%;
  bottom: 0;
  height: 150rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(255, 236, 242, 0.44) 0%, rgba(255, 236, 242, 0.18) 34%, rgba(255, 236, 242, 0.08) 56%, transparent 76%);
  filter: blur(28rpx);
  opacity: 0.82;
  animation: hero-stage-breathe 7.4s ease-in-out infinite;
  pointer-events: none;
}

.hero-stage-wrap::after {
  content: "";
  position: absolute;
  left: 18%;
  right: 18%;
  top: 12rpx;
  height: 1px;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.54) 24%, rgba(255, 255, 255, 0.18) 76%, transparent 100%);
  opacity: 0.68;
  pointer-events: none;
}

.hero-moment-band {
  width: 100%;
  max-width: 620rpx;
  padding: 4rpx 18rpx 0;
}

.hero-moment-topline {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.hero-moment-kicker {
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: var(--ink-tertiary);
}

.hero-moment-tag {
  max-width: 240rpx;
}

.hero-moment-title {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.38;
  font-weight: 600;
  color: var(--ink-primary);
}

.hero-moment-body {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  letter-spacing: 0.2rpx;
  color: var(--ink-secondary);
}

.hero-moment-body.no-title {
  margin-top: 18rpx;
}

.hero-moment-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  margin-top: 16rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--glass-quiet-bg);
  border: 1px solid var(--glass-border);
  font-size: 20rpx;
  line-height: 1.4;
  color: var(--accent-ink);
  box-shadow: var(--shadow-soft);
}

.hero-timer-card {
  position: relative;
  width: 100%;
  padding: 76rpx 40rpx 68rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 34rpx;
  overflow: visible;
  background: transparent;
  box-shadow: none;
}

.hero-stage-card::before {
  content: "";
  position: absolute;
  inset: 18rpx 22rpx 30rpx;
  border-radius: 64rpx;
  background: radial-gradient(circle at 50% 24%, rgba(255, 255, 255, 0.28) 0%, rgba(255, 250, 248, 0.1) 34%, transparent 68%);
  filter: blur(6rpx);
  opacity: 0.96;
  pointer-events: none;
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(58rpx);
  opacity: 0.44;
  pointer-events: none;
  animation: hero-breathe 9.4s ease-in-out infinite alternate;
}

.hero-glow-a {
  width: 320rpx;
  height: 320rpx;
  top: -52rpx;
  left: 24rpx;
  background: rgba(243, 154, 181, 0.34);
}

.hero-glow-b {
  width: 280rpx;
  height: 280rpx;
  right: 8rpx;
  bottom: 78rpx;
  background: rgba(142, 202, 230, 0.24);
  animation-delay: -2.4s;
}

.hero-frame-lines {
  position: absolute;
  left: 68rpx;
  right: 68rpx;
  height: 1px;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.72) 18%, rgba(255, 255, 255, 0.22) 82%, transparent 100%);
  opacity: 0.58;
  pointer-events: none;
}

.hero-frame-top {
  top: 20rpx;
}

.hero-frame-bottom {
  bottom: 44rpx;
}

.hero-timer-card::after {
  content: "";
  position: absolute;
  left: 12%;
  right: 12%;
  top: 14%;
  bottom: 8%;
  background: linear-gradient(115deg, transparent 18%, rgba(255, 255, 255, 0.22) 48%, transparent 74%);
  transform: translateX(-130%);
  animation: poster-sheen 7.8s ease-in-out infinite;
  pointer-events: none;
}

@keyframes poster-sheen {
  0%, 18% { transform: translateX(-130%); }
  46%, 100% { transform: translateX(130%); }
}

@keyframes hero-stage-breathe {
  0%, 100% {
    opacity: 0.48;
    transform: scaleX(0.92) scaleY(0.92);
  }
  50% {
    opacity: 0.92;
    transform: scaleX(1.08) scaleY(1.06);
  }
}

@keyframes hero-breathe {
  0% { transform: scale(0.9) translate3d(0, 0, 0); opacity: 0.24; }
  100% { transform: scale(1.12) translate3d(12rpx, -14rpx, 0); opacity: 0.54; }
}

.hero-timer-topline {
  position: relative;
  z-index: 1;
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.hero-timer-caption {
  position: relative;
  z-index: 1;
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: var(--ink-tertiary);
}

.hero-milestone-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: var(--glass-quiet-bg);
  border: 1px solid var(--glass-border);
  box-shadow: 0 12rpx 24rpx rgba(225, 201, 213, 0.1);
  backdrop-filter: blur(14rpx);
}

.hero-milestone-pill.is-exact {
  background: rgba(255, 248, 238, 0.76);
  box-shadow: 0 10rpx 22rpx rgba(235, 202, 149, 0.14);
}

.hero-milestone-pill-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--neon-primary);
  box-shadow: 0 0 18rpx rgba(243, 154, 181, 0.42);
  animation: pulse 1.8s ease-in-out infinite;
}

.hero-milestone-pill.is-exact .hero-milestone-pill-dot {
  background: #f1be7b;
  box-shadow: 0 0 18rpx rgba(241, 190, 123, 0.48);
}

.hero-milestone-pill-text {
  font-size: 17rpx;
  line-height: 1;
  letter-spacing: 2rpx;
  color: var(--ink-secondary);
}

.hero-days-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 20rpx;
}

.hero-days {
  font-family: var(--display-font);
  font-size: 220rpx;
  line-height: 0.84;
  font-weight: 800;
  letter-spacing: -9rpx;
  font-variant-numeric: tabular-nums lining-nums;
  text-shadow: 0 18rpx 38rpx rgba(240, 187, 199, 0.24);
}

.hero-days-unit {
  padding-bottom: 24rpx;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 600;
  color: var(--ink-secondary);
}

.hero-milestone-inline {
  position: relative;
  z-index: 1;
  margin-top: 2rpx;
  font-size: 21rpx;
  line-height: 1.56;
  color: var(--ink-soft);
}

.hero-subtime {
  position: relative;
  z-index: 1;
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  gap: 0;
  margin-top: 16rpx;
  padding: 30rpx 28rpx 0;
}

.hero-subtime::before {
  content: "";
  position: absolute;
  left: 12%;
  right: 12%;
  top: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent 0%, var(--soft-divider) 16%, var(--soft-divider) 84%, transparent 100%);
}

.hero-subtime-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.hero-subtime-divider {
  width: 1px;
  background: linear-gradient(180deg, transparent 0%, var(--soft-divider) 18%, var(--soft-divider) 82%, transparent 100%);
}

.sub-val {
  font-family: var(--display-font);
  font-size: 48rpx;
  font-weight: 700;
  color: var(--ink-primary);
  font-variant-numeric: tabular-nums lining-nums;
}

.sub-lbl {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--ink-tertiary);
  letter-spacing: 2rpx;
}

.neon-pulse {
  text-shadow: 0 0 22rpx rgba(247, 199, 166, 0.46), 0 0 34rpx rgba(243, 154, 181, 0.18);
}


.poster-lower {
  margin-top: 24rpx;
}

.lower-stage-wrap {
  border-radius: 44rpx;
}

.lower-stage-card {
  position: relative;
  border-radius: 44rpx;
  padding: 30rpx 30rpx 28rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at top right, rgba(255, 223, 233, 0.12), transparent 24%),
    radial-gradient(circle at 16% 82%, rgba(220, 239, 247, 0.1), transparent 22%),
    linear-gradient(145deg, var(--glass-bg) 0%, var(--glass-quiet-bg) 100%);
  border: 1px solid var(--glass-border);
  box-shadow: var(--shadow-soft);
}

.lower-stage-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, transparent 28%, transparent 82%, rgba(255, 255, 255, 0.04) 100%);
  pointer-events: none;
}

.lower-stage-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(48rpx);
  pointer-events: none;
  opacity: 0.08;
}

.lower-stage-glow-a {
  width: 200rpx;
  height: 200rpx;
  top: -70rpx;
  right: -32rpx;
  background: rgba(243, 154, 181, 0.08);
}

.lower-stage-glow-b {
  width: 160rpx;
  height: 160rpx;
  bottom: -28rpx;
  left: 30rpx;
  background: rgba(142, 202, 230, 0.07);
  animation-delay: -4.2s;
}

.lower-memory-band-standalone {
  margin-top: 0;
  padding-top: 0;
  border-top: none;
}

.lower-memory-band {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  padding: 4rpx 2rpx 0;
  transition: transform 0.24s ease, opacity 0.24s ease;
}

.lower-memory-band:active {
  transform: translateY(4rpx) scale(0.995);
}

.lower-memory-breathe {
  position: absolute;
  left: 50%;
  bottom: -8rpx;
  width: 92%;
  height: 128rpx;
  transform: translateX(-50%);
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(255, 232, 240, 0.34) 0%, rgba(255, 232, 240, 0.16) 38%, transparent 76%);
  filter: blur(30rpx);
  opacity: 0.52;
  pointer-events: none;
}

.lower-memory-sheen {
  display: none;
}

.lower-memory-topline {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.lower-memory-status {
  font-size: 17rpx;
  letter-spacing: 2rpx;
  color: var(--accent-ink);
}

.lower-memory-entry {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--glass-strong-bg);
  border: 1px solid var(--glass-border);
  font-size: 20rpx;
  color: var(--accent-ink);
  box-shadow: var(--shadow-soft);
}

.lower-memory-copy,
.lower-memory-emptycopy {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  font-size: 23rpx;
  line-height: 1.72;
  color: var(--ink-secondary);
}

.lower-memory-copy {
  color: var(--ink-soft);
}

.lower-memory-list {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}

.lower-memory-item {
  position: relative;
  padding-left: 14rpx;
  opacity: 0.98;
}

.lower-memory-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 10rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: var(--neon-primary);
  box-shadow: 0 0 10rpx rgba(243, 154, 181, 0.22);
}

.lower-memory-item-meta {
  font-size: 16rpx;
  letter-spacing: 0.6rpx;
  color: var(--ink-tertiary);
}

.lower-memory-item-content {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.66;
  color: var(--ink-secondary);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.lower-memory-emptycopy {
  color: var(--ink-soft);
}

.neon-spark {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 0 16rpx rgba(243, 154, 181, 0.32), 0 0 30rpx rgba(142, 202, 230, 0.22);
  animation: driftUp 8.8s linear infinite;
  opacity: 0.52;
}

@keyframes driftUp {
  0% { transform: translateY(0) scale(0.92); opacity: 0; }
  16% { opacity: 0.84; }
  78% { opacity: 0.46; }
  100% { transform: translateY(-260rpx) scale(0.44); opacity: 0; }
}

.spark-one { left: 20%; top: 60%; animation-delay: 0s; }
.spark-two { left: 80%; top: 40%; animation-delay: 2s; }
.spark-three { left: 50%; top: 80%; animation-delay: 4s; }
.spark-four { left: 10%; top: 30%; animation-delay: 1s; }
.spark-five { left: 90%; top: 70%; animation-delay: 3s; }
.spark-six { left: 40%; top: 20%; animation-delay: 5s; }

.spark-heart {
  width: 14rpx;
  height: 14rpx;
  border-radius: 6rpx 6rpx 10rpx 10rpx;
  background: rgba(255, 124, 165, 0.9);
  transform: rotate(45deg);
  box-shadow: 0 0 18rpx rgba(255, 124, 165, 0.36);
}

.spark-petal {
  width: 10rpx;
  height: 24rpx;
  border-radius: 999rpx 999rpx 999rpx 20rpx;
  background: rgba(233, 112, 143, 0.68);
  box-shadow: 0 0 16rpx rgba(233, 112, 143, 0.26);
}

.spark-bubble {
  width: 18rpx;
  height: 18rpx;
  background: rgba(255, 255, 255, 0.38);
  border: 1px solid rgba(255, 255, 255, 0.58);
  box-shadow: 0 0 18rpx rgba(142, 202, 230, 0.24);
}

.spark-snow {
  width: 8rpx;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 0 16rpx rgba(176, 220, 245, 0.38);
}

.spark-firework {
  width: 12rpx;
  height: 12rpx;
  background: rgba(255, 211, 119, 0.94);
  box-shadow: 0 0 14rpx rgba(255, 211, 119, 0.48), 0 0 32rpx rgba(255, 119, 119, 0.28);
}

.spark-gold {
  width: 12rpx;
  height: 12rpx;
  background: rgba(241, 190, 123, 0.94);
  box-shadow: 0 0 18rpx rgba(241, 190, 123, 0.42);
}

.scene-anniversary {
  --neon-primary: #f1be7b;
  --neon-secondary: #f0a4bd;
  --neon-accent: #f8dfad;
  --accent-ink: #b27a35;
}

.scene-birthday {
  --neon-primary: #f6b5c8;
  --neon-secondary: #9bd5ec;
  --neon-accent: #f8d792;
  --accent-ink: #b66b8a;
}

.scene-valentine,
.scene-520 {
  --neon-primary: #ef7fa5;
  --neon-secondary: #f3adbf;
  --neon-accent: #f5c08d;
  --accent-ink: #bd4d78;
}

.scene-521 {
  --neon-primary: #ee9fc0;
  --neon-secondary: #b9c9ff;
  --neon-accent: #f2d0e1;
  --accent-ink: #a95f91;
}

.scene-christmas {
  --neon-primary: #8ec8e8;
  --neon-secondary: #f5c375;
  --neon-accent: #d7eef8;
  --accent-ink: #4d88a0;
}

.scene-newyear {
  --neon-primary: #ff8ba8;
  --neon-secondary: #ffd277;
  --neon-accent: #85d7ff;
  --accent-ink: #bf6c3f;
}

.scene-milestone {
  --neon-primary: #efbf79;
  --neon-secondary: #f3aac1;
  --neon-accent: #ffe1a4;
  --accent-ink: #a8722e;
}

.scene-anniversary .hero-milestone-pill,
.scene-milestone .hero-milestone-pill {
  background: rgba(255, 246, 224, 0.72);
  box-shadow: 0 12rpx 28rpx rgba(239, 191, 121, 0.18);
}

.scene-christmas .hero-stage-wrap::before {
  background: radial-gradient(circle, rgba(216, 239, 248, 0.46) 0%, rgba(245, 195, 117, 0.16) 38%, transparent 76%);
}

.scene-newyear .hero-stage-card::before {
  background: radial-gradient(circle at 50% 24%, rgba(255, 211, 119, 0.2) 0%, rgba(255, 139, 168, 0.12) 36%, transparent 68%);
}

.scene-valentine .tag-dot,
.scene-520 .tag-dot {
  box-shadow: 0 0 34rpx rgba(239, 127, 165, 0.5), 0 0 54rpx rgba(239, 127, 165, 0.24);
}

@media (prefers-color-scheme: dark) {
  .hero-nameplate,
  .hero-statement {
    text-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.26);
  }

  .hero-stage-card::before,
  .lower-stage-card::after {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, transparent 34%, rgba(255, 255, 255, 0.04) 100%);
  }

  .lower-stage-card {
    background:
      radial-gradient(circle at top right, rgba(255, 120, 173, 0.14), transparent 26%),
      radial-gradient(circle at 16% 82%, rgba(117, 216, 255, 0.12), transparent 24%),
      linear-gradient(145deg, var(--glass-bg) 0%, var(--glass-quiet-bg) 100%);
  }
}

.theme-midnight .hero-nameplate,
.theme-midnight .hero-statement {
  text-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.26);
}

.theme-midnight .hero-stage-card::before,
.theme-midnight .lower-stage-card::after {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, transparent 34%, rgba(255, 255, 255, 0.04) 100%);
}

.theme-midnight .lower-stage-card {
  background:
    radial-gradient(circle at top right, rgba(255, 120, 173, 0.14), transparent 26%),
    radial-gradient(circle at 16% 82%, rgba(117, 216, 255, 0.12), transparent 24%),
    linear-gradient(145deg, var(--glass-bg) 0%, var(--glass-quiet-bg) 100%);
}
