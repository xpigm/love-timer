/* pages/index/index.wxss */

.header-status {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 60rpx;
}

.tag-special {
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-color: var(--neon-accent);
  color: #fff;
  background: rgba(236, 72, 153, 0.15); /* neon-accent with opacity */
}

.tag-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--neon-accent);
  box-shadow: 0 0 10px var(--neon-accent);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% { opacity: 0.5; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
  100% { opacity: 0.5; transform: scale(0.8); }
}

.hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 60rpx;
}

.hero-names {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink-secondary);
  letter-spacing: 4rpx;
  text-transform: uppercase;
  margin-bottom: 16rpx;
}

.hero-motto {
  margin-bottom: 48rpx;
  line-height: 1.1;
  text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
}

.timer-wrap {
  width: 100%;
  max-width: 600rpx;
  margin-bottom: 32rpx;
}

.timer-card {
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
  /* 增强卡片质感 */
  background: linear-gradient(180deg, rgba(39, 39, 42, 0.4) 0%, rgba(24, 24, 27, 0.6) 100%);
}

.timer-main {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.timer-days {
  font-family: "Inter", "Times New Roman", serif;
  font-size: 160rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -4rpx;
  /* 文字内部阴影增加立体感 */
  text-shadow: 0 10px 30px rgba(139, 92, 246, 0.4);
}

.timer-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink-secondary);
  letter-spacing: 6rpx;
  margin-top: 16rpx;
}

.timer-subs {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 100%;
  padding-top: 40rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
}

.timer-sub-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 100rpx;
}

.sub-val {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--ink-primary);
  font-variant-numeric: tabular-nums;
}

.sub-lbl {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--ink-tertiary);
  letter-spacing: 2rpx;
  margin-top: 8rpx;
}

.timer-sub-divider {
  font-size: 40rpx;
  font-weight: 300;
  color: var(--ink-tertiary);
  margin-bottom: 30rpx;
}

.neon-pulse {
  text-shadow: 0 0 15px var(--neon-accent);
}

.hero-tags {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  justify-content: center;
}

/* Bento Grid */
.bento-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.bento-card {
  padding: 40rpx;
}

.bento-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.bento-icon {
  color: var(--neon-primary);
  font-size: 32rpx;
  text-shadow: 0 0 10px var(--neon-primary);
}

.bento-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-secondary);
  letter-spacing: 2rpx;
}

.quote-text {
  font-size: 34rpx;
  line-height: 1.6;
  color: var(--ink-primary);
  font-weight: 500;
  margin-bottom: 32rpx;
}

.bento-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

.btn-mini {
  height: 60rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
}

.bento-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  padding: 32rpx !important;
}

.stat-val {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--ink-primary);
  margin-bottom: 8rpx;
}

.stat-lbl {
  font-size: 22rpx;
  color: var(--ink-tertiary);
  font-weight: 600;
  letter-spacing: 1px;
}

/* Spotlight Message Card */
.spotlight-card {
  padding: 40rpx;
  margin-bottom: 40rpx;
}

.spotlight-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.spot-eyebrow {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--neon-secondary);
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
  display: block;
}

.spot-desc {
  margin-bottom: 32rpx;
}

.notes-preview-area {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.note-item {
  padding: 24rpx 0;
  border-top: 1px dashed rgba(255, 255, 255, 0.1);
}

.note-item:first-child {
  border-top: none;
  padding-top: 0;
}

.note-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.note-author {
  font-size: 28rpx;
  font-weight: 700;
}

.note-time {
  font-size: 22rpx;
  color: var(--ink-tertiary);
}

.note-content {
  font-size: 28rpx;
  color: var(--ink-primary);
  line-height: 1.6;
  white-space: pre-wrap;
}

.spot-actions {
  margin-top: 24rpx;
}

/* 漂浮发光粒子动画补全 (原 sceneDecorations 适配) */
.neon-spark {
  position: absolute;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 0 10px #fff, 0 0 20px var(--neon-primary);
  animation: driftUp 8s linear infinite;
  opacity: 0.6;
}

@keyframes driftUp {
  0% { transform: translateY(0) scale(1); opacity: 0; }
  20% { opacity: 0.8; }
  80% { opacity: 0.6; }
  100% { transform: translateY(-200px) scale(0.5); opacity: 0; }
}

.spark-one { left: 20%; top: 60%; animation-delay: 0s; }
.spark-two { left: 80%; top: 40%; animation-delay: 2s; }
.spark-three { left: 50%; top: 80%; animation-delay: 4s; }
.spark-four { left: 10%; top: 30%; animation-delay: 1s; }
.spark-five { left: 90%; top: 70%; animation-delay: 3s; }
.spark-six { left: 40%; top: 20%; animation-delay: 5s; }
