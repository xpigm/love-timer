.page {
  min-height: 100vh;
}

.theme-blush {
  background: linear-gradient(180deg, #fff7f4 0%, #fff1f1 55%, #fff7f4 100%);
}

.theme-ocean {
  background: linear-gradient(180deg, #eef8ff 0%, #f5fbff 55%, #eef8ff 100%);
}

.theme-sunset {
  background: linear-gradient(180deg, #fff5ec 0%, #fff0e9 55%, #fff8f2 100%);
}

.hero {
  position: relative;
  overflow: hidden;
  padding-bottom: 26rpx;
}

.scene-default .hero {
  background: linear-gradient(180deg, rgba(255, 244, 243, 0.5) 0%, rgba(255, 255, 255, 0) 100%);
}

.scene-anniversary .hero {
  background: linear-gradient(180deg, rgba(255, 235, 214, 0.76) 0%, rgba(255, 247, 240, 0) 100%);
}

.scene-valentine .hero {
  background: linear-gradient(180deg, rgba(255, 224, 234, 0.82) 0%, rgba(255, 244, 246, 0) 100%);
}

.scene-520 .hero {
  background: linear-gradient(180deg, rgba(255, 218, 210, 0.86) 0%, rgba(255, 245, 242, 0) 100%);
}

.scene-521 .hero {
  background: linear-gradient(180deg, rgba(255, 228, 237, 0.84) 0%, rgba(255, 246, 248, 0) 100%);
}

.scene-christmas .hero {
  background: linear-gradient(180deg, rgba(215, 240, 245, 0.86) 0%, rgba(244, 251, 253, 0) 100%);
}

.scene-newyear .hero {
  background: linear-gradient(180deg, rgba(28, 46, 86, 0.88) 0%, rgba(60, 83, 125, 0.12) 100%);
}

.scene-milestone .hero {
  background: linear-gradient(180deg, rgba(255, 233, 196, 0.78) 0%, rgba(255, 248, 236, 0) 100%);
}

.hero-inner {
  position: relative;
  z-index: 2;
  padding-top: 28rpx;
}

.hero-card {
  position: relative;
  padding: 34rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 251, 249, 0.78) 100%);
}

.scene-anniversary .hero-card {
  background: linear-gradient(180deg, rgba(255, 252, 245, 0.94) 0%, rgba(255, 247, 235, 0.84) 100%);
  box-shadow: 0 24rpx 56rpx rgba(197, 146, 72, 0.15);
}

.scene-valentine .hero-card {
  background: linear-gradient(180deg, rgba(255, 248, 251, 0.94) 0%, rgba(255, 238, 244, 0.84) 100%);
}

.scene-520 .hero-card {
  background: linear-gradient(180deg, rgba(255, 248, 245, 0.94) 0%, rgba(255, 235, 226, 0.84) 100%);
}

.scene-521 .hero-card {
  background: linear-gradient(180deg, rgba(255, 248, 251, 0.94) 0%, rgba(255, 240, 246, 0.84) 100%);
}

.scene-christmas .hero-card {
  background: linear-gradient(180deg, rgba(245, 252, 253, 0.94) 0%, rgba(235, 247, 249, 0.84) 100%);
  box-shadow: 0 24rpx 56rpx rgba(83, 135, 150, 0.14);
}

.scene-newyear .hero-card {
  background: linear-gradient(180deg, rgba(248, 249, 255, 0.96) 0%, rgba(232, 238, 250, 0.88) 100%);
  box-shadow: 0 24rpx 56rpx rgba(17, 31, 69, 0.22);
}

.scene-milestone .hero-card {
  background: linear-gradient(180deg, rgba(255, 252, 245, 0.94) 0%, rgba(255, 244, 226, 0.84) 100%);
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-city {
  color: #9b7d86;
  font-size: 24rpx;
}

.hero-kicker {
  margin-top: 32rpx;
  color: #b2858d;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 10rpx;
  text-transform: uppercase;
}

.hero-divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 220rpx;
  margin-top: 18rpx;
}

.hero-divider-line {
  flex: 1;
  height: 2rpx;
  background: rgba(211, 137, 155, 0.28);
}

.hero-divider-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #d9879b;
  box-shadow: 0 0 0 8rpx rgba(217, 135, 155, 0.12);
}

.scene-anniversary .hero-kicker,
.scene-milestone .hero-kicker {
  color: #b38a4d;
}

.scene-anniversary .hero-divider-line,
.scene-milestone .hero-divider-line {
  background: rgba(196, 145, 65, 0.26);
}

.scene-anniversary .hero-divider-dot,
.scene-milestone .hero-divider-dot {
  background: #c49141;
  box-shadow: 0 0 0 8rpx rgba(196, 145, 65, 0.12);
}

.scene-christmas .hero-kicker {
  color: #5e9eab;
}

.scene-christmas .hero-divider-line {
  background: rgba(95, 158, 171, 0.26);
}

.scene-christmas .hero-divider-dot {
  background: #5e9eab;
  box-shadow: 0 0 0 8rpx rgba(95, 158, 171, 0.12);
}

.scene-newyear .hero-kicker {
  color: #6076bb;
}

.scene-newyear .hero-divider-line {
  background: rgba(96, 118, 187, 0.26);
}

.scene-newyear .hero-divider-dot {
  background: #6076bb;
  box-shadow: 0 0 0 8rpx rgba(96, 118, 187, 0.14);
}

.hero-title {
  margin-top: 22rpx;
  font-size: 46rpx;
  font-weight: 700;
  color: #402d35;
  line-height: 1.3;
}

.hero-subtitle {
  margin-top: 14rpx;
  color: #7e646f;
  font-size: 26rpx;
}

.hero-promise {
  margin-top: 16rpx;
  color: #c3637a;
  font-size: 26rpx;
}

.scene-anniversary .hero-promise,
.scene-milestone .hero-promise {
  color: #b67a2c;
}

.scene-christmas .hero-promise {
  color: #4f94a3;
}

.scene-newyear .hero-promise {
  color: #4460a8;
}

.timer-panel {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-top: 34rpx;
}

.timer-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 152rpx;
  border-radius: 28rpx;
  background: rgba(255, 246, 244, 0.96);
}

.scene-anniversary .timer-item,
.scene-milestone .timer-item {
  background: rgba(255, 248, 234, 0.96);
}

.scene-valentine .timer-item,
.scene-520 .timer-item,
.scene-521 .timer-item {
  background: rgba(255, 243, 246, 0.96);
}

.scene-christmas .timer-item {
  background: rgba(240, 249, 250, 0.96);
}

.scene-newyear .timer-item {
  background: rgba(237, 242, 255, 0.96);
}

.timer-item-strong {
  background: linear-gradient(135deg, #ff8fa3 0%, #ffb19f 100%);
  color: #ffffff;
}

.scene-anniversary .timer-item-strong,
.scene-milestone .timer-item-strong {
  background: linear-gradient(135deg, #f0ba62 0%, #f2c987 100%);
}

.scene-valentine .timer-item-strong {
  background: linear-gradient(135deg, #ff839e 0%, #ffb2c1 100%);
}

.scene-521 .timer-item-strong {
  background: linear-gradient(135deg, #ff8db1 0%, #ffc0d4 100%);
}

.scene-christmas .timer-item-strong {
  background: linear-gradient(135deg, #6bc4d7 0%, #9cdde5 100%);
}

.scene-newyear .timer-item-strong {
  background: linear-gradient(135deg, #4c69be 0%, #7c8fe5 100%);
}

.timer-value {
  font-size: 44rpx;
  font-weight: 700;
}

.timer-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.hero-actions {
  margin-top: 30rpx;
}

.flex-btn {
  flex: 1;
}

.content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 36rpx;
}

.scene-card,
.quote-card,
.action-card {
  padding: 28rpx;
}

.scene-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.scene-title {
  margin-bottom: 0;
}

.scene-badge {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 239, 240, 0.86);
  color: #cb6b7e;
  font-size: 22rpx;
  font-weight: 600;
}

.scene-anniversary .scene-badge,
.scene-milestone .scene-badge {
  background: rgba(255, 242, 214, 0.96);
  color: #b07a2c;
}

.scene-christmas .scene-badge {
  background: rgba(231, 247, 249, 0.96);
  color: #4b93a2;
}

.scene-newyear .scene-badge {
  background: rgba(233, 238, 255, 0.96);
  color: #4862a3;
}

.scene-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.scene-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #fff4f2;
  color: #9d6673;
  font-size: 22rpx;
}

.scene-anniversary .scene-chip,
.scene-milestone .scene-chip {
  background: #fff7e9;
  color: #ad7933;
}

.scene-christmas .scene-chip {
  background: #effafb;
  color: #4f92a0;
}

.scene-newyear .scene-chip {
  background: #edf1ff;
  color: #5367aa;
}

.quote-text {
  font-size: 34rpx;
  color: #3f3036;
  line-height: 1.7;
}

.quote-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 22rpx;
}

.mini-btn {
  min-height: 72rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
}

.section-block {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.stat-card,
.note-card {
  padding: 24rpx;
}

.stat-label {
  color: #8f7078;
  font-size: 24rpx;
}

.stat-value {
  margin-top: 12rpx;
  color: #3c2d35;
  font-size: 38rpx;
  font-weight: 700;
}

.stat-desc {
  margin-top: 12rpx;
  color: #997f87;
  font-size: 22rpx;
  line-height: 1.6;
}

.note-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.note-author {
  color: #3d2d35;
  font-size: 28rpx;
  font-weight: 600;
}

.note-time {
  color: #a0848a;
  font-size: 22rpx;
}

.note-content {
  margin-top: 16rpx;
  color: #765f68;
  line-height: 1.8;
  white-space: pre-wrap;
}

.action-row {
  margin-top: 24rpx;
}

.hero-glow,
.float-dot,
.scene-spark {
  position: absolute;
  border-radius: 999rpx;
}

.hero-glow-left {
  top: 40rpx;
  left: -100rpx;
  width: 320rpx;
  height: 320rpx;
  background: rgba(255, 179, 190, 0.3);
  filter: blur(20rpx);
}

.hero-glow-right {
  top: 80rpx;
  right: -80rpx;
  width: 260rpx;
  height: 260rpx;
  background: rgba(255, 212, 183, 0.4);
  filter: blur(22rpx);
}

.scene-anniversary .hero-glow-left,
.scene-milestone .hero-glow-left {
  background: rgba(247, 201, 119, 0.34);
}

.scene-anniversary .hero-glow-right,
.scene-milestone .hero-glow-right {
  background: rgba(255, 230, 177, 0.42);
}

.scene-valentine .hero-glow-left,
.scene-521 .hero-glow-left {
  background: rgba(255, 171, 203, 0.34);
}

.scene-christmas .hero-glow-left {
  background: rgba(155, 220, 231, 0.36);
}

.scene-christmas .hero-glow-right {
  background: rgba(205, 243, 245, 0.42);
}

.scene-newyear .hero-glow-left {
  background: rgba(107, 139, 234, 0.34);
}

.scene-newyear .hero-glow-right {
  background: rgba(255, 193, 105, 0.28);
}

.float-dot {
  background: rgba(255, 255, 255, 0.55);
  animation: drift 6s ease-in-out infinite;
}

.dot-a {
  top: 180rpx;
  left: 70rpx;
  width: 30rpx;
  height: 30rpx;
}

.dot-b {
  top: 120rpx;
  right: 120rpx;
  width: 46rpx;
  height: 46rpx;
  animation-delay: 1s;
}

.dot-c {
  top: 360rpx;
  right: 70rpx;
  width: 20rpx;
  height: 20rpx;
  animation-delay: 2s;
}

.scene-spark {
  z-index: 1;
  opacity: 0.8;
  animation: drift 7s ease-in-out infinite;
}

.spark-one {
  top: 120rpx;
  left: 28rpx;
  width: 32rpx;
  height: 32rpx;
  background: rgba(255, 255, 255, 0.7);
}

.spark-two {
  top: 220rpx;
  right: 48rpx;
  width: 18rpx;
  height: 18rpx;
  background: rgba(255, 255, 255, 0.64);
  animation-delay: 1s;
}

.spark-three {
  top: 420rpx;
  left: 120rpx;
  width: 20rpx;
  height: 20rpx;
  background: rgba(255, 255, 255, 0.58);
  animation-delay: 2s;
}

.spark-four {
  top: 480rpx;
  right: 150rpx;
  width: 28rpx;
  height: 28rpx;
  background: rgba(255, 255, 255, 0.62);
  animation-delay: 3s;
}

.spark-five {
  top: 160rpx;
  right: 220rpx;
  width: 42rpx;
  height: 42rpx;
  animation-delay: 1.5s;
}

.spark-six {
  top: 360rpx;
  left: 210rpx;
  width: 38rpx;
  height: 38rpx;
  animation-delay: 2.5s;
}

.spark-heart {
  background: linear-gradient(135deg, rgba(255, 121, 154, 0.95) 0%, rgba(255, 176, 157, 0.9) 100%);
  transform: rotate(45deg);
  border-radius: 12rpx;
}

.spark-petal {
  background: linear-gradient(135deg, rgba(255, 127, 160, 0.92) 0%, rgba(255, 193, 214, 0.86) 100%);
  border-radius: 60% 40% 60% 40%;
}

.spark-bubble {
  background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.95), rgba(255, 165, 202, 0.74));
}

.spark-snow {
  background: radial-gradient(circle at 40% 40%, rgba(255, 255, 255, 0.96), rgba(190, 231, 239, 0.82));
}

.spark-firework {
  background: radial-gradient(circle at 35% 35%, rgba(255, 227, 160, 0.98), rgba(95, 129, 225, 0.86));
}

.spark-gold {
  background: linear-gradient(135deg, rgba(255, 217, 128, 0.95) 0%, rgba(247, 188, 89, 0.88) 100%);
}

@keyframes drift {
  0% {
    transform: translateY(0);
    opacity: 0.45;
  }
  50% {
    transform: translateY(-14rpx);
    opacity: 0.95;
  }
  100% {
    transform: translateY(0);
    opacity: 0.45;
  }
}
