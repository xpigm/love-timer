/* pages/index/index.wxss */

.poster-page {
  min-height: 100vh;
}

.poster-shell {
  display: flex;
  flex-direction: column;
  gap: 104rpx;
  padding-top: 60rpx;
  padding-bottom: 88rpx;
}

.poster-topline {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.poster-tags {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.poster-topside {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.tag-special {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-right: 28rpx;
}

.tag-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--neon-primary);
  box-shadow: 0 0 30rpx rgba(243, 154, 181, 0.62), 0 0 44rpx rgba(243, 154, 181, 0.26);
  animation: pulse 1.6s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.6; transform: scale(0.84); }
  50% { opacity: 1; transform: scale(1.26); }
}

.poster-city {
  padding-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  letter-spacing: 6rpx;
  color: var(--ink-tertiary);
  text-transform: uppercase;
  text-align: right;
}

.poster-kicker {
  font-size: 18rpx;
  letter-spacing: 8rpx;
  color: rgba(150, 136, 156, 0.72);
}

.poster-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 30rpx;
  padding: 52rpx 0 34rpx;
}

.hero-nameplate {
  font-size: 56rpx;
  line-height: 1.14;
  font-weight: 600;
  letter-spacing: -1.6rpx;
  color: var(--ink-primary);
  text-shadow: 0 10rpx 28rpx rgba(255, 255, 255, 0.42);
}

.name-sep {
  display: inline-block;
  margin: 0 10rpx;
  color: rgba(125, 103, 120, 0.5);
}

.hero-statement {
  max-width: 540rpx;
  font-size: 28rpx;
  line-height: 1.72;
  color: rgba(111, 99, 119, 0.92);
  letter-spacing: 1.2rpx;
}

.hero-coverline {
  font-size: 20rpx;
  line-height: 1.7;
  letter-spacing: 4rpx;
  color: rgba(150, 136, 156, 0.88);
  text-transform: uppercase;
}

.hero-timer-wrap {
  position: relative;
  width: 100%;
  max-width: 700rpx;
  margin-top: 34rpx;
  padding: 26rpx 18rpx 18rpx;
}

.hero-stage-wrap::before {
  content: "";
  position: absolute;
  left: 8%;
  right: 8%;
  bottom: 0;
  height: 150rpx;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(255, 236, 242, 0.44) 0%, rgba(255, 236, 242, 0.18) 34%, rgba(255, 236, 242, 0.08) 56%, transparent 76%);
  filter: blur(28rpx);
  opacity: 0.82;
  animation: hero-stage-breathe 7.4s ease-in-out infinite;
  pointer-events: none;
}

.hero-stage-wrap::after {
  content: "";
  position: absolute;
  left: 18%;
  right: 18%;
  top: 12rpx;
  height: 1px;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.54) 24%, rgba(255, 255, 255, 0.18) 76%, transparent 100%);
  opacity: 0.68;
  pointer-events: none;
}

.hero-moment-band {
  width: 100%;
  max-width: 620rpx;
  padding: 4rpx 18rpx 0;
}

.hero-moment-topline {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.hero-moment-kicker {
  font-size: 18rpx;
  letter-spacing: 4rpx;
  color: rgba(150, 136, 156, 0.78);
}

.hero-moment-tag {
  max-width: 240rpx;
}

.hero-moment-title {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.38;
  font-weight: 600;
  color: rgba(79, 67, 86, 0.92);
}

.hero-moment-body {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  letter-spacing: 0.2rpx;
  color: rgba(79, 67, 86, 0.84);
}

.hero-moment-body.no-title {
  margin-top: 18rpx;
}

.hero-moment-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: rgba(203, 136, 161, 0.82);
}

.hero-timer-card {
  position: relative;
  width: 100%;
  padding: 76rpx 40rpx 68rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 34rpx;
  overflow: visible;
  background: transparent;
  box-shadow: none;
}

.hero-stage-card::before {
  content: "";
  position: absolute;
  inset: 18rpx 22rpx 30rpx;
  border-radius: 64rpx;
  background: radial-gradient(circle at 50% 24%, rgba(255, 255, 255, 0.28) 0%, rgba(255, 250, 248, 0.1) 34%, transparent 68%);
  filter: blur(6rpx);
  opacity: 0.96;
  pointer-events: none;
}

.hero-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(58rpx);
  opacity: 0.44;
  pointer-events: none;
  animation: hero-breathe 9.4s ease-in-out infinite alternate;
}

.hero-glow-a {
  width: 320rpx;
  height: 320rpx;
  top: -52rpx;
  left: 24rpx;
  background: rgba(243, 154, 181, 0.34);
}

.hero-glow-b {
  width: 280rpx;
  height: 280rpx;
  right: 8rpx;
  bottom: 78rpx;
  background: rgba(142, 202, 230, 0.24);
  animation-delay: -2.4s;
}

.hero-frame-lines {
  position: absolute;
  left: 68rpx;
  right: 68rpx;
  height: 1px;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.72) 18%, rgba(255, 255, 255, 0.22) 82%, transparent 100%);
  opacity: 0.58;
  pointer-events: none;
}

.hero-frame-top {
  top: 20rpx;
}

.hero-frame-bottom {
  bottom: 44rpx;
}

.hero-timer-card::after {
  content: "";
  position: absolute;
  left: 12%;
  right: 12%;
  top: 14%;
  bottom: 8%;
  background: linear-gradient(115deg, transparent 18%, rgba(255, 255, 255, 0.22) 48%, transparent 74%);
  transform: translateX(-130%);
  animation: poster-sheen 7.8s ease-in-out infinite;
  pointer-events: none;
}

@keyframes poster-sheen {
  0%, 18% { transform: translateX(-130%); }
  46%, 100% { transform: translateX(130%); }
}

@keyframes hero-stage-breathe {
  0%, 100% {
    opacity: 0.48;
    transform: scaleX(0.92) scaleY(0.92);
  }
  50% {
    opacity: 0.92;
    transform: scaleX(1.08) scaleY(1.06);
  }
}

@keyframes hero-breathe {
  0% { transform: scale(0.9) translate3d(0, 0, 0); opacity: 0.24; }
  100% { transform: scale(1.12) translate3d(12rpx, -14rpx, 0); opacity: 0.54; }
}

.hero-timer-topline {
  position: relative;
  z-index: 1;
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.hero-timer-caption {
  position: relative;
  z-index: 1;
  font-size: 20rpx;
  letter-spacing: 10rpx;
  color: rgba(150, 136, 156, 0.86);
}

.hero-milestone-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.32);
  border: none;
  box-shadow: 0 12rpx 24rpx rgba(225, 201, 213, 0.08);
  backdrop-filter: blur(14rpx);
}

.hero-milestone-pill.is-exact {
  background: rgba(255, 248, 238, 0.76);
  box-shadow: 0 10rpx 22rpx rgba(235, 202, 149, 0.14);
}

.hero-milestone-pill-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--neon-primary);
  box-shadow: 0 0 18rpx rgba(243, 154, 181, 0.42);
  animation: pulse 1.8s ease-in-out infinite;
}

.hero-milestone-pill.is-exact .hero-milestone-pill-dot {
  background: #f1be7b;
  box-shadow: 0 0 18rpx rgba(241, 190, 123, 0.48);
}

.hero-milestone-pill-text {
  font-size: 17rpx;
  line-height: 1;
  letter-spacing: 2.2rpx;
  color: rgba(111, 99, 119, 0.86);
}

.hero-days-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 20rpx;
}

.hero-days {
  font-family: "Inter", "Times New Roman", serif;
  font-size: 220rpx;
  line-height: 0.84;
  font-weight: 900;
  letter-spacing: -11rpx;
  text-shadow: 0 18rpx 38rpx rgba(240, 187, 199, 0.22);
}

.hero-days-unit {
  padding-bottom: 24rpx;
  font-size: 34rpx;
  line-height: 1;
  font-weight: 600;
  color: var(--ink-secondary);
}

.hero-milestone-inline {
  position: relative;
  z-index: 1;
  margin-top: 2rpx;
  font-size: 21rpx;
  line-height: 1.56;
  color: rgba(125, 103, 120, 0.76);
}

.hero-subtime {
  position: relative;
  z-index: 1;
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  gap: 0;
  margin-top: 16rpx;
  padding: 30rpx 28rpx 0;
}

.hero-subtime::before {
  content: "";
  position: absolute;
  left: 12%;
  right: 12%;
  top: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent 0%, rgba(214, 195, 206, 0.34) 16%, rgba(214, 195, 206, 0.18) 84%, transparent 100%);
}

.hero-subtime-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.hero-subtime-divider {
  width: 1px;
  background: linear-gradient(180deg, transparent 0%, rgba(214, 195, 206, 0.32) 18%, rgba(214, 195, 206, 0.32) 82%, transparent 100%);
}

.sub-val {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--ink-primary);
  font-variant-numeric: tabular-nums;
}

.sub-lbl {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--ink-tertiary);
  letter-spacing: 2rpx;
}

.neon-pulse {
  text-shadow: 0 0 22rpx rgba(247, 199, 166, 0.46), 0 0 34rpx rgba(243, 154, 181, 0.18);
}


.poster-lower {
  margin-top: 24rpx;
}

.lower-stage-wrap {
  border-radius: 44rpx;
}

.lower-stage-card {
  position: relative;
  border-radius: 44rpx;
  padding: 28rpx 28rpx 26rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at top right, rgba(255, 223, 233, 0.04), transparent 24%),
    radial-gradient(circle at 16% 82%, rgba(220, 239, 247, 0.04), transparent 22%),
    linear-gradient(145deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 250, 248, 0.08) 48%, rgba(255, 252, 250, 0.04) 100%);
}

.lower-stage-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, transparent 28%, transparent 82%, rgba(255, 255, 255, 0.04) 100%);
  pointer-events: none;
}

.lower-stage-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(48rpx);
  pointer-events: none;
  opacity: 0.08;
  animation: memory-ambient 11.5s ease-in-out infinite alternate;
}

.lower-stage-glow-a {
  width: 200rpx;
  height: 200rpx;
  top: -70rpx;
  right: -32rpx;
  background: rgba(243, 154, 181, 0.08);
}

.lower-stage-glow-b {
  width: 160rpx;
  height: 160rpx;
  bottom: -28rpx;
  left: 30rpx;
  background: rgba(142, 202, 230, 0.07);
  animation-delay: -4.2s;
}

.lower-memory-band-standalone {
  margin-top: 0;
  padding-top: 0;
  border-top: none;
}

.lower-memory-band {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  padding: 4rpx 2rpx 0;
  transition: transform 0.28s ease, opacity 0.28s ease;
  animation: memory-band-float 5.2s ease-in-out infinite;
}

.lower-memory-band:active {
  transform: translateY(4rpx) scale(0.995);
}

.lower-memory-breathe {
  position: absolute;
  left: 50%;
  bottom: -8rpx;
  width: 92%;
  height: 128rpx;
  transform: translateX(-50%);
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(255, 232, 240, 0.42) 0%, rgba(255, 232, 240, 0.22) 34%, rgba(255, 232, 240, 0.08) 52%, transparent 76%);
  filter: blur(30rpx);
  opacity: 0.78;
  animation: memory-breathe 4.8s ease-in-out infinite;
  pointer-events: none;
}

.lower-memory-sheen {
  position: absolute;
  top: -16rpx;
  bottom: -16rpx;
  width: 180rpx;
  background: linear-gradient(105deg, transparent 0%, rgba(255, 255, 255, 0.04) 24%, rgba(255, 255, 255, 0.22) 50%, rgba(255, 245, 248, 0.16) 62%, transparent 100%);
  transform: translateX(-220rpx) skewX(-16deg);
  animation: memory-sheen 4.6s ease-in-out infinite;
  pointer-events: none;
}

.lower-memory-topline {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.lower-memory-status {
  font-size: 16rpx;
  letter-spacing: 2.6rpx;
  color: rgba(203, 136, 161, 0.54);
}

.lower-memory-entry {
  flex-shrink: 0;
  font-size: 18rpx;
  color: rgba(203, 136, 161, 0.78);
  text-shadow: 0 0 12rpx rgba(243, 154, 181, 0.14);
  animation: memory-entry-drift 2.8s ease-in-out infinite;
}

.lower-memory-copy,
.lower-memory-emptycopy {
  position: relative;
  z-index: 1;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.72;
  color: rgba(79, 67, 86, 0.7);
}

.lower-memory-copy {
  color: rgba(111, 99, 119, 0.66);
}

.lower-memory-list {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}

.lower-memory-item {
  position: relative;
  padding-left: 14rpx;
  opacity: 0.94;
  animation: memory-drift 4.8s ease-in-out infinite;
  will-change: transform, opacity;
}

.lower-memory-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 10rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: rgba(243, 154, 181, 0.42);
  box-shadow: 0 0 10rpx rgba(243, 154, 181, 0.26);
  animation: memory-dot-pulse 2.2s ease-in-out infinite;
}

.memory-item-0 {
  animation-delay: 0s;
  animation-duration: 4.2s;
}

.memory-item-1 {
  animation-delay: -1.2s;
  animation-duration: 5s;
}

.memory-item-2 {
  animation-delay: -2.4s;
  animation-duration: 5.6s;
}

.lower-memory-item-meta {
  font-size: 16rpx;
  letter-spacing: 0.8rpx;
  color: rgba(150, 136, 156, 0.52);
}

.lower-memory-item-content {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.66;
  color: rgba(79, 67, 86, 0.72);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.lower-memory-emptycopy {
  color: rgba(111, 99, 119, 0.64);
}

@keyframes memory-ambient {
  0% {
    transform: translate3d(0, 0, 0) scale(0.88);
    opacity: 0.04;
  }
  100% {
    transform: translate3d(18rpx, -16rpx, 0) scale(1.16);
    opacity: 0.16;
  }
}

@keyframes memory-band-float {
  0%, 100% {
    transform: translate3d(0, 0, 0);
  }
  50% {
    transform: translate3d(0, -6rpx, 0);
  }
}

@keyframes memory-sheen {
  0%, 20% {
    transform: translateX(-240rpx) skewX(-16deg);
    opacity: 0;
  }
  36% {
    opacity: 1;
  }
  62%, 100% {
    transform: translateX(620rpx) skewX(-16deg);
    opacity: 0;
  }
}

@keyframes memory-breathe {
  0%, 100% {
    opacity: 0.46;
    transform: translateX(-50%) scaleX(0.84) scaleY(0.88);
  }
  50% {
    opacity: 0.98;
    transform: translateX(-50%) scaleX(1.14) scaleY(1.1);
  }
}

@keyframes memory-entry-drift {
  0%, 100% {
    transform: translate3d(0, 0, 0);
    opacity: 0.7;
  }
  50% {
    transform: translate3d(12rpx, 0, 0);
    opacity: 1;
  }
}

@keyframes memory-drift {
  0%, 100% {
    transform: translate3d(0, 0, 0);
    opacity: 0.84;
  }
  50% {
    transform: translate3d(0, -14rpx, 0);
    opacity: 1;
  }
}

@keyframes memory-dot-pulse {
  0%, 100% {
    opacity: 0.28;
    transform: scale(0.88);
  }
  50% {
    opacity: 1;
    transform: scale(1.8);
  }
}

.neon-spark {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 0 16rpx rgba(243, 154, 181, 0.32), 0 0 30rpx rgba(142, 202, 230, 0.22);
  animation: driftUp 8.8s linear infinite;
  opacity: 0.56;
}

@keyframes driftUp {
  0% { transform: translateY(0) scale(0.92); opacity: 0; }
  16% { opacity: 0.84; }
  78% { opacity: 0.46; }
  100% { transform: translateY(-260rpx) scale(0.44); opacity: 0; }
}

.spark-one { left: 20%; top: 60%; animation-delay: 0s; }
.spark-two { left: 80%; top: 40%; animation-delay: 2s; }
.spark-three { left: 50%; top: 80%; animation-delay: 4s; }
.spark-four { left: 10%; top: 30%; animation-delay: 1s; }
.spark-five { left: 90%; top: 70%; animation-delay: 3s; }
.spark-six { left: 40%; top: 20%; animation-delay: 5s; }
