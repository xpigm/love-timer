<view class="page {{themeClass}} {{sceneClass}} poster-page">
  <view class="ambient-orb orb-1" style="width: 680rpx; height: 680rpx; top: -140rpx; left: -140rpx; background: var(--neon-primary);"></view>
  <view class="ambient-orb orb-2" style="width: 560rpx; height: 560rpx; top: 260rpx; right: -180rpx; background: var(--neon-secondary); animation-delay: -3s;"></view>
  <view class="ambient-orb orb-3" style="width: 440rpx; height: 440rpx; bottom: 120rpx; left: 12%; background: var(--neon-accent); animation-delay: -5s;"></view>

  <view wx:for="{{sceneDecorations}}" wx:key="id" class="{{item.className}} neon-spark"></view>

  <view class="container poster-shell">
    <view class="poster-topline animate-enter delay-1">
      <view class="poster-tags">
        <view class="glass-tag tag-special" wx:if="{{specialLabel}}">
          <text class="tag-dot"></text>{{specialLabel}}
        </view>
      </view>
      <view class="poster-topside">
        <view class="poster-city" wx:if="{{coverTags.length}}">{{coverTags[0]}}</view>
        <view class="poster-kicker">LOVE POSTER</view>
      </view>
    </view>

    <view class="poster-hero animate-enter delay-2">
      <view class="hero-nameplate">{{profile.personA}} <text class="name-sep">·</text> {{profile.personB}}</view>
      <view class="hero-statement">{{scene.tag || coverLine}}</view>
      <view class="hero-coverline">{{coverLine}}</view>

      <view class="gradient-border-wrap hero-timer-wrap float-subtle">
        <view class="glass-card hero-timer-card">
          <view class="hero-frame-lines hero-frame-top"></view>
          <view class="hero-frame-lines hero-frame-bottom"></view>
          <view class="hero-glow hero-glow-a"></view>
          <view class="hero-glow hero-glow-b"></view>
          <view class="hero-timer-caption">TOGETHER FOR</view>
          <view class="hero-days-row">
            <text class="hero-days text-gradient">{{timer.days}}</text>
            <text class="hero-days-unit">天</text>
          </view>
          <view class="hero-subtime">
            <view class="hero-subtime-item">
              <text class="sub-val">{{timer.hours}}</text>
              <text class="sub-lbl">小时</text>
            </view>
            <view class="hero-subtime-divider"></view>
            <view class="hero-subtime-item">
              <text class="sub-val">{{timer.minutes}}</text>
              <text class="sub-lbl">分钟</text>
            </view>
            <view class="hero-subtime-divider"></view>
            <view class="hero-subtime-item">
              <text class="sub-val neon-pulse">{{timer.seconds}}</text>
              <text class="sub-lbl">秒</text>
            </view>
          </view>
          <view class="hero-sidecopy">{{summary.aside}}</view>
        </view>
      </view>
    </view>

    <view class="poster-lower animate-enter delay-3">
      <view class="gradient-border-wrap lower-stage-wrap">
        <view class="glass-card lower-stage-card">
          <view class="lower-stage-glow lower-stage-glow-a"></view>
          <view class="lower-stage-glow lower-stage-glow-b"></view>

          <view class="lower-stage-header">
            <view>
              <view class="section-kicker">今天的片段</view>
              <view class="lower-stage-title">想认真放进纪念册的部分</view>
            </view>
            <view class="lower-stage-meta">
              <view class="glass-tag lower-stage-tag" wx:if="{{summary.eyebrow}}">{{summary.eyebrow}}</view>
              <view class="lower-stage-count">{{notesCount ? notesCount + ' 条留言' : '还在等待第一条留言'}}</view>
            </view>
          </view>

          <view class="lower-stage-grid">
            <view class="lower-story">
              <view class="lower-story-head">
                <view class="glass-tag lower-story-tag" wx:if="{{scene.tag}}">{{scene.tag}}</view>
                <view class="lower-story-title">{{summary.title}}</view>
              </view>
              <view class="lower-story-body">{{summary.body}}</view>
              <view class="lower-story-aside">{{summary.aside}}</view>
              <view class="summary-actions lower-story-actions">
                <button class="btn btn-glass btn-mini" bindtap="refreshQuote">换一句</button>
                <button class="btn btn-glass btn-mini" bindtap="copySummary">复制文案</button>
              </view>
            </view>

            <view class="lower-insight-rail">
              <view class="lower-scene-brief">
                <view class="lower-scene-head">
                  <view>
                    <view class="section-kicker">此刻的氛围</view>
                    <view class="lower-scene-title">{{scene.title || coverLine}}</view>
                  </view>
                  <view class="lower-scene-metric" wx:if="{{scene.metricValue}}">{{scene.metricValue}}</view>
                </view>
                <view class="lower-scene-copy">{{scene.description || spotlight.body}}</view>
                <view class="lower-scene-footnote" wx:if="{{scene.metricDesc}}">{{scene.metricDesc}}</view>
                <view class="lower-scene-tags" wx:if="{{scene.chips.length}}">
                  <text class="lower-scene-chip" wx:for="{{scene.chips}}" wx:key="*this">{{item}}</text>
                </view>
              </view>

              <view class="lower-stat-band">
                <view class="lower-stat-item" wx:for="{{quickStats}}" wx:key="label">
                  <view class="stat-lbl">{{item.label}}</view>
                  <view class="lower-stat-val">{{item.value}}</view>
                  <view class="lower-stat-desc">{{item.desc}}</view>
                </view>
              </view>
            </view>
          </view>

          <view class="lower-memory-band">
            <view class="lower-memory-head">
              <view>
                <view class="section-kicker">最近留言</view>
                <view class="lower-memory-title">{{spotlight.title}}</view>
              </view>
              <view class="lower-memory-side">
                <view class="lower-memory-note">{{spotlight.footnote}}</view>
                <view class="glass-tag lower-memory-tag">{{notesCount ? '一起写过的片段' : '从今天开始记录'}}</view>
              </view>
            </view>

            <view class="lower-memory-copy">{{spotlight.body}}</view>

            <view class="lower-memory-list" wx:if="{{notesPreview.length}}">
              <view class="lower-memory-snippet {{item.cardClass}}" wx:for="{{notesPreview}}" wx:key="id">
                <view class="lower-memory-snippet-head">
                  <view class="lower-memory-snippet-tag">{{item.noteLabel}}</view>
                  <text class="lower-memory-time">{{item.createdAt}}</text>
                </view>
                <view class="lower-memory-author">{{item.author}}</view>
                <view class="lower-memory-content">{{item.content}}</view>
              </view>
            </view>
            <view wx:else class="empty-glass lower-memory-empty">
              还没有留言，先写下今天的一句话吧。
            </view>

            <view class="btn-row lower-memory-actions">
              <button class="btn btn-neon flex-1" bindtap="openWall">{{spotlight.cta}}</button>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
