<view class="page {{themeClass}}">
  <view class="container settings-page">
    <view class="card field-card">
      <view class="section-title">情侣资料</view>

      <view class="field-group">
        <view class="field-label">你的昵称</view>
        <input class="text-input" placeholder="例如：小安" value="{{profile.personA}}" data-field="personA" bindinput="onProfileInput" />
      </view>

      <view class="field-group">
        <view class="field-label">TA 的昵称</view>
        <input class="text-input" placeholder="例如：小满" value="{{profile.personB}}" data-field="personB" bindinput="onProfileInput" />
      </view>

      <view class="field-group">
        <view class="field-label">恋爱开始日期</view>
        <picker mode="date" value="{{profile.startDate}}" bindchange="onStartDateChange">
          <view class="picker-box">{{profile.startDate}}</view>
        </picker>
      </view>

      <view class="field-group">
        <view class="field-label">城市</view>
        <input class="text-input" placeholder="例如：上海" value="{{profile.city}}" data-field="city" bindinput="onProfileInput" />
      </view>

      <view class="field-group">
        <view class="field-label">首页标题</view>
        <input class="text-input" placeholder="例如：我们已经相恋" value="{{profile.title}}" data-field="title" bindinput="onProfileInput" />
      </view>

      <view class="field-group">
        <view class="field-label">一句承诺</view>
        <textarea class="text-area" maxlength="80" placeholder="例如：把普通日子过成纪念日。" value="{{profile.promise}}" data-field="promise" bindinput="onProfileInput"></textarea>
      </view>

      <view class="field-group">
        <view class="field-label">主题风格</view>
        <picker mode="selector" range="{{themeOptions}}" range-key="label" value="{{themeIndex}}" bindchange="onThemeChange">
          <view class="picker-box">{{themeOptions[themeIndex].label}}</view>
        </picker>
      </view>

      <view class="btn-row field-actions">
        <button class="btn-secondary flex-btn" bindtap="resetProfile">恢复默认资料</button>
        <button class="btn-primary flex-btn" bindtap="saveProfile">保存资料</button>
      </view>
    </view>

    <view class="card field-card">
      <view class="section-title">新增纪念片段</view>

      <view class="field-group">
        <view class="field-label">日期</view>
        <picker mode="date" value="{{memoryForm.date}}" bindchange="onMemoryDateChange">
          <view class="picker-box">{{memoryForm.date}}</view>
        </picker>
      </view>

      <view class="field-group">
        <view class="field-label">标题</view>
        <input class="text-input" placeholder="例如：第一次一起看海" value="{{memoryForm.title}}" data-field="title" bindinput="onMemoryInput" />
      </view>

      <view class="field-group">
        <view class="field-label">内容</view>
        <textarea class="text-area" maxlength="160" placeholder="写下当天发生的事" value="{{memoryForm.content}}" data-field="content" bindinput="onMemoryInput"></textarea>
      </view>

      <button class="btn-primary" bindtap="addMemory">加入纪念片段</button>
    </view>

    <view class="memory-section">
      <view class="section-title">当前纪念片段</view>
      <view wx:if="{{memories.length}}">
        <view class="card memory-card" wx:for="{{memories}}" wx:key="id">
          <view class="memory-top">
            <view>
              <view class="memory-date">{{item.date}}</view>
              <view class="memory-title">{{item.title}}</view>
            </view>
            <text class="memory-delete" data-id="{{item.id}}" bindtap="deleteMemory">删除</text>
          </view>
          <view class="memory-content">{{item.content}}</view>
        </view>
      </view>
      <view wx:else class="empty-state">还没有纪念片段，先新增一条属于你们的故事。</view>
    </view>

    <view class="card field-card">
      <view class="section-title">数据整理</view>
      <view class="section-desc">这里可以恢复示例纪念片段，或者清空留言墙。</view>
      <view class="btn-row field-actions">
        <button class="btn-secondary flex-btn" bindtap="restoreDefaultMemories">恢复示例片段</button>
        <button class="btn-ghost flex-btn" bindtap="clearNotes">清空留言墙</button>
      </view>
    </view>
  </view>
</view>
