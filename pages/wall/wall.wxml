<view class="page {{themeClass}} wall-poster-page">
  <view class="ambient-orb orb-1" style="width: 640rpx; height: 640rpx; top: -80rpx; right: -160rpx; background: var(--neon-secondary); opacity: 0.28;"></view>
  <view class="ambient-orb orb-2" style="width: 540rpx; height: 540rpx; top: 34%; left: -140rpx; background: var(--neon-primary); opacity: 0.3; animation-delay: -3s;"></view>
  <view class="ambient-orb orb-3" style="width: 420rpx; height: 420rpx; bottom: 10%; right: 12%; background: var(--neon-accent); opacity: 0.24; animation-delay: -5s;"></view>

  <view class="container wall-shell">
    <view class="wall-topline animate-enter delay-1">
      <view class="wall-tags">
        <view class="glass-tag wall-special-tag" wx:if="{{wallMeta.badge}}">{{wallMeta.badge}}</view>
      </view>
      <view class="wall-topside">
        <view class="wall-date">{{wallMeta.date}}</view>
        <view class="wall-kicker">{{wallMeta.kicker}}</view>
      </view>
    </view>

    <view class="wall-hero animate-enter delay-2">
      <view class="wall-nameplate">{{profile.personA}} <text class="wall-name-sep">·</text> {{profile.personB}}</view>
      <view class="wall-hero-title">{{wallHero.title}}</view>
      <view class="wall-hero-body">{{wallHero.body}}</view>
      <view class="wall-hero-meta">{{wallMeta.status}} <text class="wall-hero-meta-dot">·</text> {{wallHero.coverline}}</view>
    </view>

    <view class="wall-composer animate-enter delay-3">
      <view class="wall-composer-glow wall-composer-glow-a"></view>
      <view class="wall-composer-glow wall-composer-glow-b"></view>
      <view class="wall-composer-breathe"></view>

      <view class="wall-composer-topline">
        <view class="wall-composer-kicker">写留言</view>
        <view class="wall-composer-counter">{{form.content.length}} / 300</view>
      </view>
      <view class="wall-composer-title">{{composerPanel.title}}</view>
      <view class="wall-composer-copy">{{composerPanel.body}}</view>

      <view class="wall-author-row">
        <view class="wall-author-label">署名</view>
        <picker mode="selector" range="{{authorOptions}}" value="{{authorIndex}}" bindchange="onAuthorChange">
          <view class="wall-author-chip">{{authorOptions[authorIndex]}}</view>
        </picker>
      </view>

      <textarea
        class="wall-composer-input"
        maxlength="300"
        placeholder="写一句话、一个心情，或者今天的小瞬间。"
        placeholder-class="wall-input-placeholder"
        value="{{form.content}}"
        bindinput="onContentInput"
      ></textarea>

      <view class="wall-composer-actions">
        <view class="wall-composer-link" bindtap="fillInspiration">随机一句</view>
        <button class="btn btn-neon wall-save-btn" bindtap="submitNote">保存留言</button>
      </view>

      <view class="wall-composer-helper">{{composerPanel.helper}}</view>
    </view>

    <view class="wall-stream animate-enter delay-4">
      <view class="wall-stream-topline">
        <view>
          <view class="wall-stream-kicker">最近留言</view>
          <view class="wall-stream-title">把写过的话慢慢收起来</view>
        </view>
        <view class="wall-stream-meta">{{wallMeta.streamHint}}</view>
      </view>

      <view class="wall-stream-list" wx:if="{{notes.length}}">
        <view class="wall-note-item {{item.isLatest ? 'is-latest' : ''}}" wx:for="{{notes}}" wx:key="id">
          <view class="wall-note-meta">{{item.metaLine}}</view>
          <view class="wall-note-content">“{{item.content}}”</view>
          <view class="wall-note-actions">
            <view class="action-link" data-content="{{item.content}}" bindtap="copyNote">复制</view>
            <view class="action-link danger" data-id="{{item.id}}" bindtap="deleteNote">删除</view>
          </view>
        </view>
      </view>

      <view wx:else class="wall-stream-empty">{{wallMeta.empty}}</view>
    </view>
  </view>
</view>
