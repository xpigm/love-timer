<view class="page {{themeClass}}">
  <!-- 背景氛围光球 -->
  <view class="ambient-orb" style="width: 700rpx; height: 700rpx; top: 10%; right: -200rpx; background: var(--neon-secondary); opacity: 0.3;"></view>
  <view class="ambient-orb" style="width: 500rpx; height: 500rpx; top: 40%; left: -100rpx; background: var(--neon-primary); opacity: 0.3; animation-delay: -3s;"></view>

  <view class="container">
    <!-- 头部信息 -->
    <view class="glass-card wall-header animate-enter delay-1">
      <view class="wall-header-top">
        <view class="wall-header-text">
          <text class="spot-eyebrow">MEMORY ARCHIVE</text>
          <view class="title-primary wall-title text-gradient">记忆储藏室</view>
          <view class="text-muted">{{latestNoteLabel}}</view>
        </view>
        <view class="wall-counter-box">
          <text class="counter-val text-gradient">{{noteCount}}</text>
          <text class="counter-lbl">FRAGMENTS</text>
        </view>
      </view>

      <view class="hero-tags" style="justify-content: flex-start; margin-top: 32rpx;">
        <text class="glass-tag" wx:for="{{boardTags}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <!-- 撰写卡片 -->
    <view class="gradient-border-wrap composer-wrap animate-enter delay-2 float-subtle">
      <view class="glass-card composer-card">
        <view class="composer-header">
          <view class="spot-eyebrow">SEAL THE MOMENT</view>
          <view class="title-secondary">在这颗星球上，留下今日的回声</view>
        </view>

        <view class="composer-form">
          <view class="form-group">
            <view class="form-label">心跳来源 / 频段</view>
            <picker mode="selector" range="{{authorOptions}}" value="{{authorIndex}}" bindchange="onAuthorChange">
              <view class="glass-input picker-box">{{authorOptions[authorIndex]}}</view>
            </picker>
          </view>

          <view class="form-group">
            <view class="form-label">刻印内容</view>
            <textarea
              class="glass-input text-area"
              maxlength="300"
              placeholder="对着星空，你想说什么..."
              placeholder-class="input-placeholder"
              value="{{form.content}}"
              bindinput="onContentInput"
            ></textarea>
          </view>
        </view>

        <view class="btn-row">
          <button class="btn btn-glass flex-1" bindtap="fillInspiration">捕获流星</button>
          <button class="btn btn-neon flex-1" bindtap="submitNote">封存时光</button>
        </view>
      </view>
    </view>

    <!-- 留言列表 -->
    <view class="notes-list-section animate-enter delay-3">
      <view class="list-header">
        <view class="title-secondary">星海回响</view>
        <text class="text-muted">{{profile.personA}} ✧ {{profile.personB}}</text>
      </view>

      <view wx:if="{{notes.length}}" class="notes-grid">
        <view class="glass-card note-card" wx:for="{{notes}}" wx:key="id">
          <view class="note-card-top">
            <view class="note-author text-gradient">{{item.author}}</view>
            <view class="note-time">{{item.createdAt}}</view>
          </view>
          <view class="note-content">{{item.content}}</view>
          <view class="note-actions">
            <view class="glass-tag action-tag" data-content="{{item.content}}" bindtap="copyNote">拷贝</view>
            <view class="glass-tag action-tag danger" data-id="{{item.id}}" bindtap="deleteNote">湮灭</view>
          </view>
        </view>
      </view>

      <view wx:else class="empty-glass">
        这里安静得只听见风声，留存第一段回音吧。
      </view>
    </view>
  </view>
</view>
