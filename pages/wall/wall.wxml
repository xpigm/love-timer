<view class="page {{themeClass}} {{sceneClass}} wall-poster-page">
  <view class="ambient-orb orb-1" style="width: 640rpx; height: 640rpx; top: -80rpx; right: -160rpx; background: var(--neon-secondary); opacity: 0.28;"></view>
  <view class="ambient-orb orb-2" style="width: 540rpx; height: 540rpx; top: 34%; left: -140rpx; background: var(--neon-primary); opacity: 0.3; animation-delay: -3s;"></view>
  <view class="ambient-orb orb-3" style="width: 420rpx; height: 420rpx; bottom: 10%; right: 12%; background: var(--neon-accent); opacity: 0.24; animation-delay: -5s;"></view>

  <view wx:for="{{sceneDecorations}}" wx:key="id" class="{{item.className}} neon-spark"></view>

  <view class="container wall-shell">
    <view class="wall-topline animate-enter delay-1">

      <view class="wall-topside">
        <view class="wall-date">{{wallMeta.date}}</view>
        <view class="wall-kicker">{{wallMeta.kicker}}</view>
      </view>
    </view>

    <view class="wall-hero animate-enter delay-2">
      <view class="wall-hero-eyebrow">{{scene.heroEyebrow || wallMeta.kicker}}</view>
      <view class="wall-nameplate">{{profile.personA}} <text class="wall-name-sep">·</text> {{profile.personB}}</view>
      <view class="wall-hero-title">{{wallHero.title}}</view>
      <view class="wall-hero-body">{{wallHero.body}}</view>
      <view class="wall-hero-meta">{{wallMeta.status}} <text class="wall-hero-meta-dot">·</text> {{wallHero.coverline}}</view>
    </view>

    <view class="wall-composer animate-enter delay-3">
      <view class="wall-composer-glow wall-composer-glow-a"></view>
      <view class="wall-composer-glow wall-composer-glow-b"></view>
      <view class="wall-composer-breathe"></view>

      <view class="wall-composer-topline">
        <view class="wall-composer-kicker">{{scene.wallKicker || '写留言'}}</view>
        <view class="wall-composer-counter {{form.content.length > 240 ? 'is-warning' : ''}}">{{form.content.length}} / 300</view>
      </view>
      <view class="wall-composer-scene" wx:if="{{scene.metricDesc}}">
        <view class="wall-composer-scene-copy">{{scene.metricDesc}}</view>
      </view>
      <view class="wall-composer-title">{{composerPanel.title}}</view>
      <view class="wall-composer-copy">{{composerPanel.body}}</view>

      <view class="wall-author-row">
        <view class="wall-avatar-column">
          <button class="wall-author-avatar-wrap {{avatarUploading ? 'is-uploading' : ''}}" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{avatarUploading}}">
            <view class="wall-author-avatar-frame">
              <image class="wall-author-avatar" src="{{form.avatarUrl}}" mode="aspectFill" wx:if="{{form.avatarUrl}}"></image>
              <view class="wall-author-avatar-placeholder" wx:else></view>
            </view>
            <view class="wall-author-avatar-action">{{avatarUploading ? '传' : '换'}}</view>
          </button>
        </view>
        <view class="wall-author-main">
          <view class="wall-author-topline">
            <view class="wall-author-title">署名</view>
            <view class="wall-author-badge">可选</view>
          </view>
          <view class="wall-author-input-card">
            <input
              type="nickname"
              class="wall-author-input"
              placeholder="不填就是匿名"
              value="{{form.author}}"
              bindblur="onNicknameBlur"
              bindinput="onNicknameInput"
            />
          </view>
        </view>
      </view>

      <textarea
        class="wall-composer-input {{contentError ? 'has-error' : ''}}"
        maxlength="300"
        placeholder="今天想说点什么？"
        placeholder-class="wall-input-placeholder"
        value="{{form.content}}"
        focus="{{contentFocus}}"
        bindfocus="onContentFocus"
        bindinput="onContentInput"
      ></textarea>
      <view class="wall-content-error" wx:if="{{contentError}}">{{contentError}}</view>

      <view class="wall-composer-actions">
        <view class="wall-composer-link" bindtap="fillInspiration">随机一句</view>
        <button class="btn btn-neon wall-save-btn" loading="{{submitting}}" disabled="{{submitting || avatarUploading}}" bindtap="submitNote">{{submitting ? '保存中' : '保存留言'}}</button>
      </view>
      <view class="wall-composer-status" wx:if="{{composerError}}">{{composerError}}</view>

      <view class="wall-composer-helper">{{composerPanel.helper}}</view>
    </view>

    <view class="wall-stream animate-enter delay-4">
      <view class="wall-stream-topline">
        <view>
          <view class="wall-stream-kicker">{{scene.wallKicker || '最近留言'}}</view>
          <view class="wall-stream-title">{{scene.wallTitle || '把写过的话慢慢收起来'}}</view>
        </view>
        <view class="wall-stream-meta">{{wallMeta.streamHint}}</view>
      </view>

      <view class="wall-stream-error" wx:if="{{loadError}}">
        <view class="wall-stream-empty-title">留言暂时没有加载出来</view>
        <view class="wall-stream-empty-helper">{{loadError}}</view>
        <button class="wall-state-action" bindtap="loadData">重试</button>
      </view>

      <view class="wall-stream-loading" wx:elif="{{loadingNotes}}">正在整理留言…</view>

      <view class="wall-stream-list" wx:elif="{{notes.length}}">
        <view class="wall-note-card {{item.isLatest ? 'is-latest' : ''}}" wx:for="{{notes}}" wx:key="id">
          <view class="wall-note-header">
            <image class="wall-note-avatar" src="{{item.avatarUrl}}" wx:if="{{item.avatarUrl}}"></image>
            <view class="wall-note-avatar-placeholder" wx:else>{{item.authorInitial}}</view>
            <view class="wall-note-meta">
              <view class="wall-note-author">{{item.author}}</view>
              <view class="wall-note-time">{{item.displayTime}}<text wx:if="{{item.city}}"> · {{item.city}}</text></view>
            </view>
            <view class="wall-note-latest" wx:if="{{item.isLatest}}">最新</view>
          </view>
          <view class="wall-note-content">“{{item.content}}”</view>
          <view class="wall-note-actions">
            <view class="action-link wall-like-link {{item.likedByMe ? 'is-liked' : ''}} {{likeLoadingId === item.id ? 'is-loading' : ''}}" data-id="{{item.id}}" bindtap="toggleLike">{{item.likedByMe ? '已喜欢' : '喜欢'}}<text wx:if="{{item.likesCount}}"> · {{item.likesCount}}</text></view>
            <view class="action-link" data-id="{{item.id}}" bindtap="openReply">{{activeReplyNoteId === item.id ? '收起' : '回复'}}</view>
            <view class="action-link {{copySuccessId === item.id ? 'is-copied' : ''}}" data-id="{{item.id}}" data-content="{{item.content}}" bindtap="copyNote">{{copySuccessId === item.id ? '已复制' : '复制'}}</view>
          </view>

          <view class="wall-reply-list" wx:if="{{item.replies.length}}">
            <view class="wall-reply-item" wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id">
              <image class="wall-reply-avatar" src="{{reply.avatarUrl}}" wx:if="{{reply.avatarUrl}}"></image>
              <view class="wall-reply-avatar-placeholder" wx:else>{{reply.authorInitial}}</view>
              <view class="wall-reply-main">
                <view class="wall-reply-meta">{{reply.author}} · {{reply.displayTime}}<text wx:if="{{reply.city}}"> · {{reply.city}}</text></view>
                <view class="wall-reply-content">{{reply.content}}</view>
              </view>
            </view>
          </view>

          <view class="wall-reply-composer" wx:if="{{activeReplyNoteId === item.id}}">
            <textarea
              class="wall-reply-input"
              maxlength="180"
              placeholder="回复一句话"
              placeholder-class="wall-input-placeholder"
              value="{{replyForm.content}}"
              bindinput="onReplyInput"
            ></textarea>
            <view class="wall-reply-error" wx:if="{{replyError}}">{{replyError}}</view>
            <view class="wall-reply-actions">
              <button class="wall-reply-submit" loading="{{replySubmitting}}" disabled="{{replySubmitting || avatarUploading}}" data-id="{{item.id}}" bindtap="submitReply">{{replySubmitting ? '发送中' : '发送回复'}}</button>
            </view>
          </view>
        </view>
      </view>

      <view wx:else class="wall-stream-empty">
        <view class="wall-stream-empty-title">{{wallMeta.empty}}</view>
        <view class="wall-stream-empty-helper">写下第一句，留言墙就开始有了温度。</view>
        <view class="wall-state-action" bindtap="focusComposer">去写第一句</view>
      </view>
    </view>
  </view>
</view>
