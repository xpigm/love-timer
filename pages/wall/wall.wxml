<view class="page {{themeClass}}">
  <view class="container wall-page">
    <view class="card intro-card">
      <view class="section-title">心动留言墙</view>
      <view class="section-desc">
        我想说的话，可以记在这里，留言会保存在当前设备里。
      </view>
    </view>

    <view class="card composer-card">
      <view class="section-title">写一句想说的话</view>

      <view class="field-wrap">
        <view class="field-label">留言身份</view>
        <picker mode="selector" range="{{authorOptions}}" value="{{authorIndex}}" bindchange="onAuthorChange">
          <view class="picker-box">{{authorOptions[authorIndex]}}</view>
        </picker>
      </view>

      <view class="field-wrap">
        <view class="field-label">留言内容</view>
        <textarea
          class="text-area"
          maxlength="300"
          placeholder="写下今天想对 TA 说的话"
          value="{{form.content}}"
          bindinput="onContentInput"
        ></textarea>
      </view>

      <view class="btn-row">
        <button class="btn-secondary flex-btn" bindtap="fillInspiration">补一句灵感</button>
        <button class="btn-primary flex-btn" bindtap="submitNote">保存留言</button>
      </view>
    </view>

    <view class="list-section">
      <view class="section-title">最近留言</view>
      <view wx:if="{{notes.length}}">
        <view class="card note-card" wx:for="{{notes}}" wx:key="id">
          <view class="note-top">
            <view>
              <view class="note-author">{{item.author}}</view>
              <view class="note-time">{{item.createdAt}}</view>
            </view>
            <view class="note-actions">
              <text class="note-action" data-content="{{item.content}}" bindtap="copyNote">复制</text>
              <text class="note-action danger" data-id="{{item.id}}" bindtap="deleteNote">删除</text>
            </view>
          </view>
          <view class="note-content">{{item.content}}</view>
        </view>
      </view>
      <view wx:else class="empty-state">还没有留言，写下今天的第一句悄悄话吧。</view>
    </view>
  </view>
</view>
