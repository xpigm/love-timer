/* pages/wall/wall.wxss */

.wall-header {
  padding: 40rpx;
  margin-bottom: 40rpx;
  background: linear-gradient(180deg, rgba(39, 39, 42, 0.4) 0%, rgba(24, 24, 27, 0.2) 100%);
}

.wall-header-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.wall-title {
  margin-bottom: 8rpx;
  font-size: 56rpx;
}

.wall-counter-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 140rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--glass-border);
  backdrop-filter: blur(10px);
}

.counter-val {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.1;
}

.counter-lbl {
  font-size: 18rpx;
  color: var(--ink-tertiary);
  letter-spacing: 2px;
  margin-top: 4rpx;
}

.composer-wrap {
  margin-bottom: 60rpx;
}

.composer-card {
  padding: 40rpx;
}

.composer-header {
  margin-bottom: 32rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 24rpx;
  color: var(--ink-secondary);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.glass-input {
  width: 100%;
  background: rgba(0, 0, 0, 0.2);
  border: 1px solid var(--glass-border);
  border-radius: 24rpx;
  color: var(--ink-primary);
  font-size: 28rpx;
  transition: all 0.3s ease;
}

.glass-input:focus {
  border-color: var(--neon-primary);
  background: rgba(0, 0, 0, 0.4);
}

.picker-box {
  height: 100rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}

.text-area {
  min-height: 240rpx;
  padding: 32rpx;
  line-height: 1.6;
}

.input-placeholder {
  color: var(--ink-tertiary);
}

.notes-list-section {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 10rpx;
}

.notes-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.note-card {
  padding: 32rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.01) 100%);
}

.note-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.note-content {
  font-size: 30rpx;
  line-height: 1.7;
  color: var(--ink-primary);
  margin-bottom: 32rpx;
  white-space: pre-wrap;
}

.note-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  border-top: 1px solid rgba(255, 255, 255, 0.05);
  padding-top: 24rpx;
}

.action-tag {
  cursor: pointer;
  background: transparent;
}

.action-tag.danger {
  color: var(--neon-secondary);
  border-color: rgba(244, 63, 94, 0.3);
}
