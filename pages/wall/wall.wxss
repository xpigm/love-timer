    border-color: rgba(255, 235, 249, 0.13);
    box-shadow: 0 10rpx 24rpx rgba(5, 4, 18, 0.22);
  }

  .action-link.is-liked {
    background: linear-gradient(135deg, rgba(255, 120, 173, 0.18), rgba(255, 210, 122, 0.1));
    border-color: rgba(255, 158, 198, 0.28);
  }
}

