/* pages/wall/wall.wxss */

.wall-poster-page {
  min-height: 100vh;
}

.wall-shell {
  display: flex;
  flex-direction: column;
  gap: 72rpx;
  padding-top: 60rpx;
  padding-bottom: 88rpx;
}

.wall-topline {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.wall-tags {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.wall-topside {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.wall-special-tag {
  padding-right: 26rpx;
}

.wall-date {
  padding-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  letter-spacing: 4rpx;
  color: var(--ink-tertiary);
  text-transform: uppercase;
  text-align: right;
}

.wall-kicker {
  font-size: 18rpx;
  letter-spacing: 8rpx;
  color: rgba(150, 136, 156, 0.72);
}

.wall-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 20rpx;
  padding: 18rpx 0 10rpx;
}

.wall-nameplate {
  font-size: 50rpx;
  line-height: 1.16;
  font-weight: 600;
  letter-spacing: -1.2rpx;
  color: var(--ink-primary);
  text-shadow: 0 10rpx 28rpx rgba(255, 255, 255, 0.34);
}

.wall-name-sep {
  display: inline-block;
  margin: 0 10rpx;
  color: rgba(125, 103, 120, 0.5);
}

.wall-hero-title {
  max-width: 620rpx;
  font-size: 42rpx;
  line-height: 1.28;
  font-weight: 600;
  color: rgba(79, 67, 86, 0.94);
}

.wall-hero-body {
  max-width: 620rpx;
  font-size: 28rpx;
  line-height: 1.72;
  color: rgba(111, 99, 119, 0.88);
  letter-spacing: 0.4rpx;
}

.wall-hero-meta {
  font-size: 20rpx;
  line-height: 1.6;
  letter-spacing: 2rpx;
  color: rgba(150, 136, 156, 0.82);
}

.wall-hero-meta-dot {
  margin: 0 8rpx;
}

.wall-composer {
  position: relative;
  padding: 30rpx 26rpx 24rpx;
  border-radius: 44rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at top right, rgba(255, 223, 233, 0.08), transparent 26%),
    radial-gradient(circle at bottom left, rgba(220, 239, 247, 0.07), transparent 24%),
    linear-gradient(145deg, rgba(255, 255, 255, 0.28) 0%, rgba(255, 250, 248, 0.14) 48%, rgba(255, 252, 250, 0.08) 100%);
}

.wall-composer::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.1) 0%, transparent 28%, transparent 82%, rgba(255, 255, 255, 0.04) 100%);
  pointer-events: none;
}

.wall-composer-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(52rpx);
  pointer-events: none;
  opacity: 0.12;
  animation: wall-composer-ambient 10.8s ease-in-out infinite alternate;
}

.wall-composer-glow-a {
  width: 220rpx;
  height: 220rpx;
  top: -78rpx;
  right: -36rpx;
  background: rgba(243, 154, 181, 0.14);
}

.wall-composer-glow-b {
  width: 180rpx;
  height: 180rpx;
  bottom: -36rpx;
  left: 16rpx;
  background: rgba(142, 202, 230, 0.12);
  animation-delay: -3.8s;
}

.wall-composer-breathe {
  position: absolute;
  left: 50%;
  bottom: -12rpx;
  width: 88%;
  height: 120rpx;
  transform: translateX(-50%);
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(255, 232, 240, 0.28) 0%, rgba(255, 232, 240, 0.12) 38%, transparent 76%);
  filter: blur(28rpx);
  opacity: 0.72;
  animation: wall-composer-breathe 7.4s ease-in-out infinite;
  pointer-events: none;
}

.wall-composer-topline,
.wall-composer-title,
.wall-composer-copy,
.wall-author-row,
.wall-composer-input,
.wall-composer-actions,
.wall-composer-helper {
  position: relative;
  z-index: 1;
}

.wall-composer-topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.wall-composer-kicker {
  font-size: 18rpx;
  letter-spacing: 4rpx;
  color: rgba(150, 136, 156, 0.76);
}

.wall-composer-counter {
  font-size: 18rpx;
  color: rgba(203, 136, 161, 0.82);
}

.wall-composer-title {
  margin-top: 16rpx;
  font-size: 30rpx;
  line-height: 1.34;
  font-weight: 600;
  color: rgba(79, 67, 86, 0.94);
}

.wall-composer-copy {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.68;
  color: rgba(111, 99, 119, 0.82);
}

.wall-author-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.wall-author-label {
  font-size: 20rpx;
  color: rgba(150, 136, 156, 0.82);
}

.wall-author-chip {
  min-width: 132rpx;
  height: 68rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.7);
  color: rgba(79, 67, 86, 0.88);
  font-size: 22rpx;
  box-shadow: 0 8rpx 16rpx rgba(227, 204, 215, 0.08);
}

.wall-composer-input {
  width: 100%;
  min-height: 260rpx;
  margin-top: 18rpx;
  padding: 24rpx 24rpx 22rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.38);
  border: 1px solid rgba(255, 255, 255, 0.58);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.46);
  color: var(--ink-primary);
  font-size: 28rpx;
  line-height: 1.7;
}

.wall-input-placeholder {
  color: var(--ink-tertiary);
}

.wall-composer-actions {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.wall-composer-link {
  font-size: 22rpx;
  color: rgba(203, 136, 161, 0.84);
}

.wall-save-btn {
  min-width: 220rpx;
  height: 80rpx;
  padding: 0 30rpx;
  font-size: 24rpx;
}

.wall-composer-helper {
  margin-top: 16rpx;
  font-size: 19rpx;
  line-height: 1.58;
  color: rgba(150, 136, 156, 0.72);
}

.wall-stream {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.wall-stream-topline {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.wall-stream-kicker {
  font-size: 18rpx;
  letter-spacing: 4rpx;
  color: rgba(150, 136, 156, 0.76);
}

.wall-stream-title {
  margin-top: 10rpx;
  font-size: 32rpx;
  line-height: 1.32;
  font-weight: 600;
  color: rgba(79, 67, 86, 0.92);
}

.wall-stream-meta {
  padding-top: 8rpx;
  font-size: 20rpx;
  color: rgba(150, 136, 156, 0.72);
  text-align: right;
}

.wall-stream-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.wall-note-item {
  position: relative;
  padding: 0 0 22rpx 22rpx;
}

.wall-note-item::before {
  content: "";
  position: absolute;
  left: 0;
  top: 12rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: rgba(243, 154, 181, 0.3);
}

.wall-note-item::after {
  content: "";
  position: absolute;
  left: 2rpx;
  top: 30rpx;
  bottom: 0;
  width: 1px;
  background: linear-gradient(180deg, rgba(243, 154, 181, 0.14) 0%, rgba(243, 154, 181, 0.04) 72%, transparent 100%);
}

.wall-note-item:last-child {
  padding-bottom: 0;
}

.wall-note-item:last-child::after {
  display: none;
}

.wall-note-item.is-latest::before {
  width: 8rpx;
  height: 8rpx;
  background: rgba(243, 154, 181, 0.52);
  box-shadow: 0 0 14rpx rgba(243, 154, 181, 0.24);
}

.wall-note-meta {
  font-size: 18rpx;
  line-height: 1.5;
  color: rgba(150, 136, 156, 0.74);
}

.wall-note-content {
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.72;
  color: rgba(79, 67, 86, 0.86);
  white-space: pre-wrap;
}

.wall-note-actions {
  margin-top: 14rpx;
  display: flex;
  gap: 22rpx;
}

.action-link {
  font-size: 22rpx;
  color: rgba(111, 99, 119, 0.82);
}

.action-link.danger {
  color: #cc738d;
}

.wall-stream-empty {
  padding: 18rpx 0 0;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(111, 99, 119, 0.72);
}

@keyframes wall-composer-ambient {
  0% {
    transform: translate3d(0, 0, 0) scale(0.92);
    opacity: 0.08;
  }
  100% {
    transform: translate3d(10rpx, -10rpx, 0) scale(1.08);
    opacity: 0.16;
  }
}

@keyframes wall-composer-breathe {
  0%, 100% {
    opacity: 0.42;
    transform: translateX(-50%) scaleX(0.92) scaleY(0.92);
  }
  50% {
    opacity: 0.82;
    transform: translateX(-50%) scaleX(1.05) scaleY(1.04);
  }
}
