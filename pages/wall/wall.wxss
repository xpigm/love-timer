/* pages/wall/wall.wxss */

.wall-poster-page {
  min-height: 100vh;
}

.wall-shell {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  padding-top: 42rpx;
  padding-bottom: 88rpx;
}

.wall-page-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.page-kicker {
  font-size: 18rpx;
  color: #cb88a1;
  letter-spacing: 2.8rpx;
  margin-bottom: 10rpx;
}

.page-title {
  font-size: 42rpx;
  line-height: 1.28;
  color: var(--ink-primary);
  font-weight: 600;
}

.page-meta {
  padding-top: 8rpx;
  font-size: 22rpx;
  color: rgba(111, 99, 119, 0.88);
}

.wall-header-wrap {
  border-radius: 48rpx;
}

.wall-header {
  padding: 32rpx 30rpx 28rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.72) 0%, rgba(255, 247, 245, 0.5) 100%);
}

.wall-summary-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.wall-summary-main {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.wall-side-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 14rpx;
}

.wall-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.wall-title {
  font-size: 36rpx;
  line-height: 1.3;
  color: var(--ink-primary);
  font-weight: 600;
}

.wall-name-tag {
  align-self: center;
}

.wall-subcopy {
  max-width: 480rpx;
}

.wall-date {
  padding-top: 8rpx;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: rgba(150, 136, 156, 0.88);
}

.wall-count-chip {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.48);
  border: 1px solid rgba(255, 255, 255, 0.74);
  font-size: 20rpx;
  color: rgba(111, 99, 119, 0.9);
  box-shadow: 0 8rpx 16rpx rgba(227, 204, 215, 0.1);
}

.wall-tags {
  margin-top: 22rpx;
}

.wall-main {
  display: grid;
  grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);
  gap: 24rpx;
  align-items: start;
}

.composer-wrap {
  border-radius: 48rpx;
}

.composer-section {
  padding: 32rpx 30rpx 30rpx;
  min-height: 100%;
}

.compact-head {
  margin-bottom: 22rpx;
}

.section-title {
  font-size: 32rpx;
  line-height: 1.32;
  color: var(--ink-primary);
  font-weight: 600;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 22rpx;
  color: rgba(111, 99, 119, 0.9);
  margin-bottom: 14rpx;
  font-weight: 500;
}

.glass-input {
  width: 100%;
  background: rgba(255, 255, 255, 0.54);
  border: 1px solid rgba(255, 255, 255, 0.76);
  border-radius: 24rpx;
  color: var(--ink-primary);
  font-size: 28rpx;
  transition: all 0.24s ease;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.54);
}

.glass-input:focus {
  border-color: rgba(238, 155, 180, 0.74);
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 0 0 4rpx rgba(255, 216, 230, 0.18);
}

.picker-box {
  height: 92rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
}

.text-area {
  min-height: 272rpx;
  padding: 28rpx;
  line-height: 1.68;
}

.input-placeholder {
  color: var(--ink-tertiary);
}

.composer-actions {
  margin-top: 6rpx;
}

.notes-list-section {
  display: flex;
  flex-direction: column;
}

.notes-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.note-card {
  padding: 28rpx 26rpx 22rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.72) 0%, rgba(255, 248, 246, 0.5) 100%);
  box-shadow: 0 14rpx 28rpx rgba(227, 204, 215, 0.12);
}

.note-stamp {
  margin-bottom: 16rpx;
  font-size: 17rpx;
  letter-spacing: 4rpx;
  color: rgba(150, 136, 156, 0.82);
}

.note-card-top {
  margin-bottom: 18rpx;
}

.note-author-block {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.note-author {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink-primary);
}

.note-time {
  font-size: 20rpx;
  color: rgba(150, 136, 156, 0.86);
}

.note-content {
  font-size: 29rpx;
  line-height: 1.7;
  color: var(--ink-primary);
  margin-bottom: 22rpx;
  white-space: pre-wrap;
}

.note-actions {
  display: flex;
  gap: 22rpx;
  justify-content: flex-end;
  border-top: 1px solid rgba(208, 185, 198, 0.18);
  padding-top: 18rpx;
}

.action-link {
  font-size: 22rpx;
  color: rgba(111, 99, 119, 0.86);
}

.action-link.danger {
  color: #cc738d;
}

.pin-left {
  transform: rotate(-0.45deg);
}

.pin-right {
  transform: rotate(0.45deg);
}

.pin-flat {
  transform: rotate(0deg);
}

.wall-empty {
  margin-top: 4rpx;
}
