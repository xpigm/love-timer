/* pages/wall/wall.wxss */

.wall-poster-page {
  min-height: 100vh;
}

.wall-shell {
  display: flex;
  flex-direction: column;
  gap: 72rpx;
  padding-top: 60rpx;
  padding-bottom: 88rpx;
}

.wall-topline {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.wall-tags {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.wall-topside {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.wall-special-tag {
  padding-right: 26rpx;
}

.wall-special-tag-seal,
.wall-special-tag-medal {
  background: linear-gradient(135deg, rgba(255, 248, 232, 0.92) 0%, rgba(255, 236, 205, 0.78) 100%);
  color: #9d6a2f;
}

.wall-special-tag-glow,
.wall-special-tag-spotlight {
  background: linear-gradient(135deg, rgba(255, 234, 242, 0.92) 0%, rgba(255, 244, 232, 0.78) 100%);
  color: #bd4d78;
}

.wall-special-tag-frost {
  background: linear-gradient(135deg, rgba(243, 251, 255, 0.94) 0%, rgba(228, 244, 251, 0.78) 100%);
  color: #4d88a0;
}

.wall-scene-chip {
  min-height: 56rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  font-size: 20rpx;
}

.wall-scene-chip-medal,
.wall-scene-chip-festival {
  background: linear-gradient(135deg, rgba(255, 248, 232, 0.9) 0%, rgba(255, 236, 205, 0.72) 100%);
  color: #9d6a2f;
}

.wall-scene-chip-rose,
.wall-scene-chip-soft {
  background: rgba(255, 255, 255, 0.76);
}

.wall-scene-chip-frost {
  background: linear-gradient(135deg, rgba(243, 251, 255, 0.94) 0%, rgba(228, 244, 251, 0.78) 100%);
  color: #4d88a0;
}

.wall-date {
  padding-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  letter-spacing: 4rpx;
  color: var(--ink-tertiary);
  text-transform: uppercase;
  text-align: right;
}

.wall-kicker {
  font-size: 18rpx;
  letter-spacing: 5rpx;
  color: var(--ink-tertiary);
}

.wall-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 20rpx;
  padding: 18rpx 0 10rpx;
}

.wall-hero-eyebrow {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--scene-pill-bg);
  border: 1px solid var(--scene-card-border);
  font-size: 18rpx;
  line-height: 1;
  letter-spacing: 4rpx;
  color: var(--accent-ink);
  box-shadow: var(--shadow-soft);
}

.wall-nameplate {
  font-family: "Songti SC", "STSong", "PingFang SC", serif;
  font-size: 50rpx;
  line-height: 1.16;
  font-weight: 600;
  letter-spacing: -1rpx;
  color: var(--ink-primary);
  text-shadow: 0 10rpx 28rpx rgba(255, 255, 255, 0.34);
}

.wall-name-sep {
  display: inline-block;
  margin: 0 10rpx;
  color: rgba(125, 103, 120, 0.5);
}

.wall-hero-title {
  max-width: 620rpx;
  font-size: 42rpx;
  line-height: 1.28;
  font-weight: 600;
  color: var(--ink-primary);
}

.wall-hero-body {
  max-width: 620rpx;
  font-size: 28rpx;
  line-height: 1.72;
  color: var(--ink-secondary);
  letter-spacing: 0.3rpx;
}

.wall-hero-meta {
  font-size: 20rpx;
  line-height: 1.6;
  letter-spacing: 1.6rpx;
  color: var(--ink-tertiary);
}

.wall-hero-meta-dot {
  margin: 0 8rpx;
}

.wall-composer {
  position: relative;
  padding: 32rpx 28rpx 26rpx;
  border-radius: 44rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at top right, var(--scene-card-tint) 0%, transparent 26%),
    radial-gradient(circle at bottom left, var(--scene-highlight) 0%, transparent 24%),
    linear-gradient(145deg, var(--glass-bg) 0%, var(--glass-quiet-bg) 100%);
  border: 1px solid var(--scene-card-border);
  box-shadow: var(--shadow-soft);
}

.wall-composer::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.1) 0%, transparent 28%, transparent 82%, rgba(255, 255, 255, 0.04) 100%);
  pointer-events: none;
}

.wall-composer-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(52rpx);
  pointer-events: none;
  opacity: 0.12;
  animation: wall-composer-ambient 10.8s ease-in-out infinite alternate;
}

.wall-composer-glow-a {
  width: 220rpx;
  height: 220rpx;
  top: -78rpx;
  right: -36rpx;
  background: rgba(243, 154, 181, 0.14);
}

.wall-composer-glow-b {
  width: 180rpx;
  height: 180rpx;
  bottom: -36rpx;
  left: 16rpx;
  background: rgba(142, 202, 230, 0.12);
  animation-delay: -3.8s;
}

.wall-composer-breathe {
  position: absolute;
  left: 50%;
  bottom: -12rpx;
  width: 88%;
  height: 120rpx;
  transform: translateX(-50%);
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(255, 232, 240, 0.28) 0%, rgba(255, 232, 240, 0.12) 38%, transparent 76%);
  filter: blur(28rpx);
  opacity: 0.72;
  animation: wall-composer-breathe 7.4s ease-in-out infinite;
  pointer-events: none;
}

.wall-composer-topline,
.wall-composer-title,
.wall-composer-copy,
.wall-author-row,
.wall-composer-input,
.wall-image-panel,
.wall-composer-actions,
.wall-composer-helper {
  position: relative;
  z-index: 1;
}

.wall-composer-topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.wall-composer-kicker {
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: var(--ink-tertiary);
}

.wall-composer-counter {
  font-family: var(--display-font);
  font-size: 18rpx;
  color: var(--accent-ink);
  font-variant-numeric: tabular-nums lining-nums;
}

.wall-composer-counter.is-warning {
  color: #bd5574;
}

.wall-composer-scene {
  margin-top: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.wall-composer-scene-badge {
  flex-shrink: 0;
  min-height: 56rpx;
  padding: 0 22rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--scene-pill-bg);
  border: 1px solid var(--scene-card-border);
  color: var(--accent-ink);
  font-size: 20rpx;
}

.wall-composer-scene-copy {
  font-size: 20rpx;
  line-height: 1.58;
  color: var(--ink-tertiary);
  text-align: right;
}

.wall-composer-title {
  margin-top: 16rpx;
  font-size: 30rpx;
  line-height: 1.34;
  font-weight: 600;
  color: var(--ink-primary);
}

.wall-composer-copy {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.68;
  color: var(--ink-secondary);
}

.wall-author-row {
  margin-top: 24rpx;
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  padding: 22rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.34);
  border: 1px solid var(--glass-border);
}

.wall-avatar-column {
  flex-shrink: 0;
  width: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wall-author-avatar-wrap {
  position: relative;
  width: 104rpx;
  height: 104rpx;
  min-width: 104rpx;
  min-height: 104rpx;
  padding: 0;
  margin: 0;
  display: block;
  background: transparent;
  border: none;
  line-height: normal;
  overflow: visible;
}

.wall-author-avatar-wrap::after {
  display: none;
}

.wall-author-avatar-frame {
  position: absolute;
  left: 6rpx;
  top: 6rpx;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--glass-strong-bg);
  border: 1px solid var(--glass-border);
  box-shadow: var(--shadow-soft);
}

.wall-author-avatar,
.wall-author-avatar-placeholder {
  display: block;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: var(--glass-strong-bg);
}

.wall-author-avatar-placeholder {
  background:
    radial-gradient(circle at 50% 42%, rgba(180, 94, 130, 0.24) 0 20%, transparent 21%),
    radial-gradient(circle at 50% 86%, rgba(180, 94, 130, 0.18) 0 32%, transparent 33%),
    var(--glass-quiet-bg);
}

.wall-author-avatar-wrap.is-uploading {
  opacity: 0.76;
}

.wall-author-avatar-action {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--neon-primary);
  border: 2px solid var(--glass-strong-bg);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  color: #fff;
  font-size: 17rpx;
  font-weight: 600;
  z-index: 2;
}

.wall-author-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.wall-author-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.wall-author-title {
  font-size: 22rpx;
  line-height: 1.4;
  font-weight: 600;
  color: var(--ink-primary);
}

.wall-author-badge {
  min-height: 40rpx;
  padding: 0 16rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--scene-pill-bg);
  color: var(--ink-tertiary);
  font-size: 18rpx;
}

.wall-author-input-card {
  min-height: 70rpx;
  margin-top: 12rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  border-radius: 24rpx;
  background: var(--glass-quiet-bg);
  border: 1px solid var(--glass-border);
}

.wall-author-input {
  width: 100%;
  height: 70rpx;
  padding: 0;
  background: transparent;
  color: var(--ink-primary);
  font-size: 26rpx;
}

.wall-composer-input {
  width: 100%;
  min-height: 260rpx;
  margin-top: 18rpx;
  padding: 24rpx 24rpx 22rpx;
  border-radius: 30rpx;
  background: var(--glass-strong-bg);
  border: 1px solid var(--glass-border);
  box-shadow: inset 0 1px 0 var(--glass-border-highlight);
  color: var(--ink-primary);
  font-size: 28rpx;
  line-height: 1.7;
}

.wall-composer-input.has-error {
  border-color: rgba(189, 85, 116, 0.58);
  box-shadow: inset 0 1px 0 var(--glass-border-highlight), 0 0 0 4rpx rgba(189, 85, 116, 0.08);
}

.wall-input-placeholder {
  color: var(--ink-tertiary);
}

.wall-image-panel {
  margin-top: 16rpx;
  padding: 14rpx;
  border-radius: 26rpx;
  background: var(--glass-strong-bg);
  border: 1px solid var(--glass-border);
  box-shadow: inset 0 1px 0 var(--glass-border-highlight);
}

.wall-image-preview {
  display: block;
  width: 100%;
  height: 260rpx;
  border-radius: 22rpx;
  background: var(--glass-quiet-bg);
  border: 1px solid rgba(255, 255, 255, 0.5);
}

.wall-image-panel-meta {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.wall-image-title {
  font-size: 21rpx;
  color: var(--ink-tertiary);
}

.wall-image-action {
  min-height: 46rpx;
  padding: 0 18rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--glass-quiet-bg);
  border: 1px solid var(--glass-border);
  color: var(--accent-ink);
  font-size: 20rpx;
}

.wall-content-error,
.wall-composer-status {
  margin-top: 10rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: #bd5574;
}

.wall-composer-actions {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.wall-composer-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--glass-quiet-bg);
  border: 1px solid var(--glass-border);
  font-size: 22rpx;
  color: var(--accent-ink);
}

.wall-save-btn {
  min-width: 220rpx;
  height: 80rpx;
  padding: 0 30rpx;
  font-size: 24rpx;
}

.wall-save-btn[disabled] {
  opacity: 0.68;
}

.wall-composer-helper {
  margin-top: 16rpx;
  font-size: 20rpx;
  line-height: 1.58;
  color: var(--ink-tertiary);
}

.wall-stream {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.wall-stream-topline {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.wall-stream-kicker {
  font-size: 18rpx;
  letter-spacing: 3rpx;
  color: var(--ink-tertiary);
}

.wall-stream-title {
  margin-top: 10rpx;
  font-size: 32rpx;
  line-height: 1.32;
  font-weight: 600;
  color: var(--ink-primary);
}

.wall-stream-meta {
  padding-top: 8rpx;
  font-size: 20rpx;
  color: var(--ink-tertiary);
  text-align: right;
}

.wall-stream-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.wall-note-card {
  position: relative;
  padding: 22rpx 22rpx 18rpx;
  border-radius: 28rpx;
  background:
    radial-gradient(circle at 92% 12%, rgba(238, 155, 180, 0.16), transparent 28%),
    linear-gradient(145deg, rgba(255, 255, 255, 0.84) 0%, rgba(255, 250, 247, 0.64) 100%);
  border: 1px solid rgba(255, 255, 255, 0.68);
  box-shadow: 0 12rpx 30rpx rgba(214, 188, 205, 0.16), inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
  overflow: hidden;
}

.wall-note-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 34rpx;
  width: 78rpx;
  height: 6rpx;
  border-radius: 0 0 999rpx 999rpx;
  background: linear-gradient(90deg, rgba(238, 155, 180, 0.5), rgba(237, 189, 157, 0.36));
  opacity: 0.82;
  pointer-events: none;
}

.wall-note-card::after {
  content: "";
  position: absolute;
  top: -22rpx;
  right: -24rpx;
  width: 132rpx;
  height: 132rpx;
  background: radial-gradient(circle, var(--scene-highlight) 0%, transparent 66%);
  opacity: 0.16;
  pointer-events: none;
}

.wall-note-card.is-latest {
  border-color: rgba(238, 155, 180, 0.46);
  box-shadow: 0 14rpx 34rpx rgba(214, 188, 205, 0.22), inset 0 1rpx 0 rgba(255, 255, 255, 0.74);
}

.wall-note-card.is-latest::before {
  width: 108rpx;
  background: linear-gradient(90deg, rgba(238, 155, 180, 0.74), rgba(255, 213, 173, 0.54));
}

.wall-note-header {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.wall-note-avatar,
.wall-note-avatar-placeholder {
  flex-shrink: 0;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: var(--glass-quiet-bg);
  border: 1px solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 6rpx 14rpx rgba(214, 188, 205, 0.14);
}

.wall-note-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(238, 155, 180, 0.26), rgba(237, 189, 157, 0.22));
  color: var(--accent-ink);
  font-size: 20rpx;
  font-weight: 600;
}

.wall-note-meta {
  flex: 1;
  min-width: 0;
}

.wall-note-author {
  font-size: 23rpx;
  line-height: 1.3;
  font-weight: 700;
  color: var(--ink-primary);
}

.wall-note-time {
  margin-top: 1rpx;
  font-size: 18rpx;
  line-height: 1.35;
  color: var(--ink-tertiary);
}

.wall-note-latest {
  min-height: 36rpx;
  padding: 0 14rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: rgba(238, 155, 180, 0.18);
  color: var(--accent-ink);
  font-size: 18rpx;
  box-shadow: inset 0 0 0 1px rgba(238, 155, 180, 0.16);
}

.wall-note-content {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  font-size: 28rpx;
  line-height: 1.62;
  color: var(--ink-primary);
  white-space: pre-wrap;
}

.wall-note-image {
  position: relative;
  z-index: 1;
  display: block;
  width: 100%;
  height: 340rpx;
  margin-top: 14rpx;
  border-radius: 24rpx;
  background: var(--glass-quiet-bg);
  border: 1px solid rgba(255, 255, 255, 0.56);
  box-shadow: 0 10rpx 22rpx rgba(214, 188, 205, 0.13);
}

.wall-note-actions {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  padding-top: 12rpx;
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 10rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.44);
}

.action-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.38);
  border: 1px solid rgba(255, 255, 255, 0.52);
  font-size: 21rpx;
  color: var(--ink-secondary);
  box-shadow: 0 6rpx 14rpx rgba(214, 188, 205, 0.08);
}

.wall-like-link {
  min-width: 92rpx;
}

.action-link.is-copied,
.action-link.is-liked {
  color: var(--accent-ink);
  border-color: rgba(238, 155, 180, 0.44);
}

.action-link.is-liked {
  background: linear-gradient(135deg, rgba(255, 237, 244, 0.84), rgba(255, 245, 232, 0.68));
  box-shadow: 0 8rpx 18rpx rgba(238, 155, 180, 0.14);
}

.action-link.is-loading {
  opacity: 0.64;
}

.action-link.danger {
  color: #bd5574;
}

.wall-reply-list {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 18rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.32);
  border: 1px solid var(--glass-border);
}

.wall-reply-item {
  display: flex;
  gap: 12rpx;
}

.wall-reply-avatar,
.wall-reply-avatar-placeholder {
  flex-shrink: 0;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: var(--glass-quiet-bg);
  border: 1px solid var(--glass-border);
}

.wall-reply-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent-ink);
  font-size: 18rpx;
  font-weight: 600;
}

.wall-reply-main {
  flex: 1;
  min-width: 0;
}

.wall-reply-meta {
  font-size: 19rpx;
  line-height: 1.45;
  color: var(--ink-tertiary);
}

.wall-reply-content {
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.58;
  color: var(--ink-primary);
  white-space: pre-wrap;
}

.wall-reply-image {
  display: block;
  width: 320rpx;
  max-width: 100%;
  height: 190rpx;
  margin-top: 8rpx;
  border-radius: 18rpx;
  background: var(--glass-quiet-bg);
  border: 1px solid rgba(255, 255, 255, 0.48);
}

.wall-reply-composer {
  position: relative;
  z-index: 1;
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.3);
  border: 1px solid var(--glass-border);
}

.wall-reply-input {
  width: 100%;
  min-height: 120rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: var(--glass-strong-bg);
  border: 1px solid var(--glass-border);
  color: var(--ink-primary);
  font-size: 25rpx;
  line-height: 1.56;
}

.wall-reply-error {
  margin-top: 8rpx;
  color: #bd5574;
  font-size: 20rpx;
  line-height: 1.5;
}

.wall-reply-actions {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.wall-reply-link {
  min-height: 56rpx;
  padding: 0 20rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--glass-quiet-bg);
  border: 1px solid var(--glass-border);
  color: var(--accent-ink);
  font-size: 21rpx;
}

.wall-reply-image-panel {
  margin-top: 12rpx;
  padding: 12rpx;
  border-radius: 22rpx;
}

.wall-reply-image-preview {
  height: 180rpx;
  border-radius: 18rpx;
}

.wall-reply-submit {
  min-height: 60rpx;
  margin: 0;
  padding: 0 24rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--glass-strong-bg);
  border: 1px solid var(--glass-border);
  color: var(--accent-ink);
  font-size: 22rpx;
}

.wall-reply-submit::after {
  display: none;
}

.wall-stream-empty,
.wall-stream-error,
.wall-stream-loading {
  padding: 42rpx 34rpx;
  border-radius: 34rpx;
  border: 1px dashed var(--scene-card-border);
  background: var(--empty-state-bg);
  box-shadow: var(--shadow-soft);
}

.wall-stream-loading {
  color: var(--ink-tertiary);
  font-size: 24rpx;
  line-height: 1.6;
}

.wall-stream-error {
  border-style: solid;
}

.wall-stream-empty-title {
  font-size: 26rpx;
  line-height: 1.62;
  color: var(--ink-secondary);
}

.wall-stream-empty-helper {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--ink-tertiary);
}

.wall-state-action,
.wall-load-more {
  min-height: 64rpx;
  margin-top: 22rpx;
  padding: 0 26rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: var(--glass-strong-bg);
  border: 1px solid var(--glass-border);
  color: var(--accent-ink);
  font-size: 23rpx;
  line-height: 1;
}

.wall-load-more {
  align-self: center;
  margin-top: 30rpx;
}

button.wall-state-action {
  margin-left: 0;
  margin-right: 0;
}

button.wall-state-action::after {
  display: none;
}

@keyframes wall-composer-ambient {
  0% {
    transform: translate3d(0, 0, 0) scale(0.92);
    opacity: 0.08;
  }
  100% {
    transform: translate3d(10rpx, -10rpx, 0) scale(1.08);
    opacity: 0.16;
  }
}

@keyframes wall-composer-breathe {
  0%, 100% {
    opacity: 0.42;
    transform: translateX(-50%) scaleX(0.92) scaleY(0.92);
  }
  50% {
    opacity: 0.72;
    transform: translateX(-50%) scaleX(1.04) scaleY(1.03);
  }
}

@media (prefers-color-scheme: dark) {
