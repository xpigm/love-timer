/* pages/wall/wall.wxss */

.wall-poster-page {
  min-height: 100vh;
}

.wall-shell {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  padding-top: 42rpx;
  padding-bottom: 88rpx;
}

.wall-page-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.page-kicker {
  font-size: 18rpx;
  color: #cb88a1;
  letter-spacing: 2.8rpx;
  margin-bottom: 10rpx;
}

.page-title {
  font-size: 42rpx;
  line-height: 1.28;
  color: var(--ink-primary);
  font-weight: 600;
}

.page-meta {
  padding-top: 8rpx;
  font-size: 22rpx;
  color: rgba(111, 99, 119, 0.88);
}

.wall-header-wrap {
  border-radius: 48rpx;
}

.wall-header {
  padding: 30rpx 28rpx 26rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.68) 0%, rgba(255, 247, 245, 0.46) 100%);
}

.wall-summary-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
}

.wall-summary-main {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.wall-side-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.wall-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.wall-title {
  font-size: 36rpx;
  line-height: 1.3;
  color: var(--ink-primary);
  font-weight: 600;
}

.wall-name-tag {
  align-self: center;
}

.wall-subcopy {
  max-width: 520rpx;
}

.wall-date {
  padding-top: 6rpx;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: rgba(150, 136, 156, 0.86);
}

.wall-count-chip {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.42);
  border: 1px solid rgba(255, 255, 255, 0.68);
  font-size: 20rpx;
  color: rgba(111, 99, 119, 0.86);
  box-shadow: 0 6rpx 14rpx rgba(227, 204, 215, 0.08);
}

.wall-tags {
  margin-top: 20rpx;
}

.wall-story {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.wall-cover-wrap,
.composer-wrap {
  border-radius: 48rpx;
}

.wall-cover-card {
  position: relative;
  padding: 30rpx 28rpx 28rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at top right, rgba(255, 224, 235, 0.14), transparent 28%),
    radial-gradient(circle at bottom left, rgba(220, 239, 247, 0.1), transparent 24%),
    linear-gradient(145deg, rgba(255, 255, 255, 0.72) 0%, rgba(255, 249, 247, 0.44) 100%);
}

.wall-cover-card::after {
  content: "";
  position: absolute;
  inset: 18rpx;
  border-radius: 32rpx;
  border: 1px solid rgba(255, 255, 255, 0.16);
  pointer-events: none;
}

.wall-cover-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(52rpx);
  pointer-events: none;
  opacity: 0.14;
}

.wall-cover-glow-a {
  width: 220rpx;
  height: 220rpx;
  top: -72rpx;
  right: -32rpx;
  background: rgba(243, 154, 181, 0.14);
}

.wall-cover-glow-b {
  width: 180rpx;
  height: 180rpx;
  bottom: -28rpx;
  left: 18rpx;
  background: rgba(142, 202, 230, 0.1);
}

.wall-cover-top {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 22rpx;
}

.wall-cover-title {
  margin-top: 8rpx;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 600;
  color: rgba(79, 67, 86, 0.92);
}

.wall-cover-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.wall-cover-badge {
  max-width: 240rpx;
}

.wall-cover-date {
  font-size: 20rpx;
  color: rgba(150, 136, 156, 0.78);
}

.wall-cover-body {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  max-width: 620rpx;
  font-size: 28rpx;
  line-height: 1.72;
  color: rgba(79, 67, 86, 0.9);
}

.wall-cover-footnote {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  font-size: 20rpx;
  line-height: 1.58;
  color: rgba(111, 99, 119, 0.76);
}

.wall-cover-stats {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 22rpx;
}

.wall-stat-chip {
  padding: 18rpx 16rpx 16rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.24);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28);
}

.wall-stat-label {
  font-size: 17rpx;
  color: rgba(150, 136, 156, 0.78);
}

.wall-stat-value {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(79, 67, 86, 0.88);
}

.composer-section {
  padding: 28rpx 26rpx 26rpx;
}

.memory-composer-card {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.72) 0%, rgba(255, 249, 247, 0.46) 100%);
}

.composer-shell {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.compact-head {
  margin-bottom: 0;
}

.composer-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
}

.composer-tag {
  margin-top: 2rpx;
}

.section-title {
  font-size: 32rpx;
  line-height: 1.32;
  color: var(--ink-primary);
  font-weight: 600;
}

.composer-copy {
  font-size: 23rpx;
  line-height: 1.64;
  color: rgba(111, 99, 119, 0.84);
}

.composer-helper {
  font-size: 20rpx;
  line-height: 1.56;
  color: rgba(150, 136, 156, 0.76);
}

.composer-form-card {
  padding: 22rpx 20rpx 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.24);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28);
}

.form-group {
  margin-bottom: 20rpx;
}

.composer-content-group {
  margin-bottom: 0;
}

.form-label {
  font-size: 22rpx;
  color: rgba(111, 99, 119, 0.9);
  margin-bottom: 14rpx;
  font-weight: 500;
}

.glass-input {
  width: 100%;
  background: rgba(255, 255, 255, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.72);
  border-radius: 24rpx;
  color: var(--ink-primary);
  font-size: 28rpx;
  transition: all 0.24s ease;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5);
}

.glass-input:focus {
  border-color: rgba(238, 155, 180, 0.68);
  background: rgba(255, 255, 255, 0.68);
  box-shadow: 0 0 0 4rpx rgba(255, 216, 230, 0.16);
}

.picker-box {
  height: 92rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
}

.text-area {
  min-height: 260rpx;
  padding: 26rpx;
  line-height: 1.68;
}

.input-placeholder {
  color: var(--ink-tertiary);
}

.composer-action-row {
  margin-top: 2rpx;
}

.memory-stream-section {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.memory-stream-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.memory-stream-meta {
  padding-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.5;
  color: rgba(150, 136, 156, 0.76);
  text-align: right;
}

.notes-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.memory-stream-grid {
  gap: 18rpx;
}

.note-card {
  padding: 24rpx 22rpx 20rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.68) 0%, rgba(255, 248, 246, 0.44) 100%);
  box-shadow: 0 10rpx 22rpx rgba(227, 204, 215, 0.08);
}

.memory-note-card {
  border-radius: 30rpx;
}

.note-stamp {
  margin-bottom: 14rpx;
  font-size: 17rpx;
  letter-spacing: 4rpx;
  color: rgba(150, 136, 156, 0.78);
}

.note-card-top {
  margin-bottom: 16rpx;
}

.note-author-block {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.note-author {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink-primary);
}

.note-time {
  font-size: 20rpx;
  color: rgba(150, 136, 156, 0.82);
}

.note-content {
  font-size: 28rpx;
  line-height: 1.68;
  color: rgba(79, 67, 86, 0.88);
  margin-bottom: 20rpx;
  white-space: pre-wrap;
}

.note-actions {
  display: flex;
  gap: 22rpx;
  justify-content: flex-end;
  border-top: 1px solid rgba(208, 185, 198, 0.16);
  padding-top: 16rpx;
}

.action-link {
  font-size: 22rpx;
  color: rgba(111, 99, 119, 0.82);
}

.action-link.danger {
  color: #cc738d;
}

.pin-left {
  transform: rotate(-0.18deg);
}

.pin-right {
  transform: rotate(0.24deg);
}

.pin-flat {
  transform: rotate(0deg);
}

.wall-empty {
  margin-top: 4rpx;
}

.memory-empty-card {
  padding: 36rpx 26rpx;
  font-size: 24rpx;
}
