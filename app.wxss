/* app.wxss - Fresh glass light theme */

page {
  background: #fffaf7;
  color: #4f4356;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Icons", "Helvetica Neue", "PingFang SC", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

/* 全局变量定义区 */
.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;

  /* --- 颜色变量 --- */
  --bg-base: #fffaf7;
  --ink-primary: #4f4356;
  --ink-secondary: #6f6377;
  --ink-tertiary: #96889c;

  /* 柔和点缀色 */
  --neon-primary: #eea6bb;
  --neon-secondary: #9bcce2;
  --neon-accent: #f2c9ad;

  /* 轻玻璃材质 */
  --glass-bg: rgba(255, 255, 255, 0.6);
  --glass-border: rgba(255, 255, 255, 0.76);
  --glass-border-highlight: rgba(255, 255, 255, 0.88);

  /* 缓动曲线 */
  --apple-ease: cubic-bezier(0.25, 1, 0.5, 1);
  --fluent-ease: cubic-bezier(0.16, 1, 0.3, 1);

  /* 柔和阴影 */
  --glow-primary: 0 0 24px rgba(243, 154, 181, 0.14);
  --shadow-glass: 0 14px 32px rgba(214, 188, 205, 0.18);

  /* 背景渐变遮罩 */
  background:
    radial-gradient(circle at 12% 12%, rgba(243, 154, 181, 0.24), transparent 34%),
    radial-gradient(circle at 88% 18%, rgba(142, 202, 230, 0.22), transparent 30%),
    radial-gradient(circle at 50% 100%, rgba(247, 199, 166, 0.22), transparent 34%),
    linear-gradient(180deg, #fffaf7 0%, #fffefb 42%, #fdf7f5 100%);
}

/* 针对不同主题的光影变体 */
.theme-blush {
  --neon-primary: #eba7bb;
  --neon-secondary: #f2c6aa;
  --neon-accent: #f9dde7;
  background:
    radial-gradient(circle at top left, rgba(238, 155, 180, 0.26), transparent 34%),
    radial-gradient(circle at bottom right, rgba(247, 195, 161, 0.2), transparent 30%),
    linear-gradient(180deg, #fff8f8 0%, #fffdfb 45%, #fef6f6 100%);
}

.theme-ocean {
  --neon-primary: #92c5e0;
  --neon-secondary: #abd7c8;
  --neon-accent: #deeff7;
  background:
    radial-gradient(circle at top left, rgba(137, 200, 232, 0.22), transparent 34%),
    radial-gradient(circle at bottom right, rgba(159, 216, 195, 0.22), transparent 30%),
    linear-gradient(180deg, #f6fbff 0%, #fcfffe 45%, #f4fbf8 100%);
}

.ambient-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(132px);
  opacity: 0.5;
  pointer-events: none;
  z-index: 0;
  mix-blend-mode: multiply;
  animation: fluent-flow 18s var(--apple-ease) infinite alternate;
  will-change: transform;
}

.orb-1 {
  animation-duration: 20s;
}

.orb-2 {
  animation-duration: 24s;
}

.orb-3 {
  animation-duration: 28s;
}

@keyframes fluent-flow {
  0% { transform: translate3d(0, 0, 0) scale(1) rotate(0deg); }
  26% { transform: translate3d(30rpx, -36rpx, 0) scale(1.08) rotate(5deg); }
  58% { transform: translate3d(-26rpx, 40rpx, 0) scale(0.94) rotate(-4deg); }
  100% { transform: translate3d(22rpx, -18rpx, 0) scale(1.05) rotate(4deg); }
}

.glass-card {
  position: relative;
  z-index: 10;
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  backdrop-filter: blur(30px) saturate(138%);
  -webkit-backdrop-filter: blur(30px) saturate(138%);
  border-radius: 44rpx;
  box-shadow: var(--shadow-glass);
  overflow: hidden;
  transition: transform 0.4s var(--apple-ease), box-shadow 0.4s var(--apple-ease);
  will-change: transform;
}

.float-subtle {
  animation: float-subtle 8.8s ease-in-out infinite alternate;
}

@keyframes float-subtle {
  0% { transform: translate3d(0, 0, 0); }
  100% { transform: translate3d(0, -18rpx, 0); }
}

.glass-card::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.72), transparent);
  z-index: 1;
}

.animate-enter {
  animation: fade-in-up 0.9s var(--fluent-ease) both;
}
.delay-1 { animation-delay: 0.1s; }
.delay-2 { animation-delay: 0.2s; }
.delay-3 { animation-delay: 0.3s; }
.delay-4 { animation-delay: 0.4s; }

@keyframes fade-in-up {
  0% {
    opacity: 0;
    transform: translateY(40px) scale(0.98);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.container {
  position: relative;
  z-index: 10;
  padding: 40rpx 32rpx;
}

.title-primary {
  font-size: 68rpx;
  font-weight: 800;
  color: var(--ink-primary);
  letter-spacing: -0.04em;
}

.title-secondary {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink-primary);
  letter-spacing: -0.02em;
}

.text-gradient {
  background: linear-gradient(120deg, #f1a3bc 0%, #f6b28d 48%, #8fcbe8 100%);
  background-size: 250% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: text-shine 9.8s linear infinite;
}

@keyframes text-shine {
  to { background-position: 220% center; }
}

.text-muted {
  color: var(--ink-secondary);
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 400;
}

.btn-row {
  display: flex;
  gap: 24rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 46rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0;
  border: none;
  transition: all 0.28s var(--apple-ease);
  padding: 0 36rpx;
}

.btn::after {
  display: none;
}

.btn:active {
  transform: scale(0.98);
  opacity: 0.88;
}

.btn-neon {
  background: linear-gradient(135deg, #f5c6d2 0%, #f4d4bb 100%);
  color: #5b4d5f;
  box-shadow: 0 10px 20px rgba(243, 154, 181, 0.16);
}

.btn-glass {
  background: rgba(255, 255, 255, 0.46);
  border: 1px solid rgba(255, 255, 255, 0.78);
  color: var(--ink-primary);
  backdrop-filter: blur(16px);
}

.flex-1 {
  flex: 1;
}

.glass-tag {
  padding: 10rpx 22rpx;
  border-radius: 38rpx;
  background: rgba(255, 255, 255, 0.56);
  border: 1px solid rgba(255, 255, 255, 0.78);
  color: var(--ink-primary);
  font-size: 22rpx;
  font-weight: 500;
  backdrop-filter: blur(8px);
  box-shadow: 0 8rpx 18rpx rgba(225, 201, 213, 0.12);
}

.empty-glass {
  padding: 60rpx 40rpx;
  text-align: center;
  border: 1px dashed rgba(197, 176, 191, 0.45);
  border-radius: 32rpx;
  color: var(--ink-secondary);
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.36);
}

.gradient-border-wrap {
  position: relative;
  border-radius: 46rpx;
  padding: 2px;
  background: linear-gradient(135deg, rgba(255, 220, 232, 0.78), rgba(244, 204, 174, 0.72), rgba(220, 239, 247, 0.78));
  background-size: 220% 220%;
  animation: border-flow 13s ease infinite alternate;
  box-shadow: 0 8px 18px rgba(232, 205, 215, 0.1), 0 0 0 1px rgba(255, 255, 255, 0.18);
}

@keyframes border-flow {
  0% { background-position: 0% 50%; }
  100% { background-position: 100% 50%; }
}

.gradient-border-wrap > .glass-card {
  border: none;
  height: 100%;
  border-radius: 44rpx;
}
