  --neon-accent: #f8d792;
  --accent-ink: #b66b8a;
  --scene-bg-top: #fff9fb;
  --scene-bg-mid: #fffefa;
  --scene-bg-bottom: #fff5f1;
  --scene-orb-a: rgba(246, 181, 200, 0.24);
  --scene-orb-b: rgba(155, 213, 236, 0.2);
  --scene-orb-c: rgba(248, 215, 146, 0.18);
  --scene-card-tint: rgba(255, 243, 247, 0.24);
