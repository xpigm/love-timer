  --scene-bg-mid: #fffbff;
  --scene-bg-bottom: #f8f2ff;
  --scene-orb-a: rgba(238, 159, 192, 0.22);
  --scene-orb-b: rgba(185, 201, 255, 0.18);
  --scene-orb-c: rgba(242, 208, 225, 0.18);
  --scene-card-tint: rgba(252, 243, 250, 0.24);
