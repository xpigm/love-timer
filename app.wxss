page {
  background: #fff7f4;
  color: #3c2d35;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

.container {
  padding: 28rpx;
}

.card {
  background: rgba(255, 255, 255, 0.86);
  border-radius: 32rpx;
  box-shadow: 0 18rpx 42rpx rgba(126, 88, 100, 0.08);
  overflow: hidden;
}

.section-title {
  margin-bottom: 18rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #3b2b31;
}

.section-desc {
  margin-top: 10rpx;
  color: #8a6f78;
  font-size: 24rpx;
  line-height: 1.6;
}

.pill {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.42);
  color: #7f4d5c;
  font-size: 22rpx;
}

.btn-row {
  display: flex;
  gap: 18rpx;
}

.btn-primary,
.btn-secondary,
.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: 0;
}

.btn-primary {
  background: linear-gradient(135deg, #ff8ca1 0%, #ffb69d 100%);
  color: #ffffff;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.72);
  color: #7a5562;
}

.btn-ghost {
  background: #fff1ef;
  color: #d26e80;
}

button::after {
  border: 0;
}

.field-card {
  padding: 26rpx;
}

.field-label {
  margin-bottom: 14rpx;
  color: #795a65;
  font-size: 24rpx;
}

.text-input,
.text-area,
.picker-box {
  width: 100%;
  border-radius: 24rpx;
  background: #fffaf9;
  border: 2rpx solid #f4dfdc;
  color: #3c2d35;
  font-size: 28rpx;
}

.text-input,
.picker-box {
  min-height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
}

.text-area {
  min-height: 180rpx;
  padding: 20rpx 24rpx;
  line-height: 1.7;
}

.muted {
  color: #987e85;
}

.empty-state {
  padding: 38rpx 30rpx;
  border-radius: 28rpx;
  background: #fffaf9;
  color: #8d737c;
  line-height: 1.7;
  text-align: center;
}
