  --neon-secondary: #ffd27a;
  --neon-accent: #d7eef8;
  --scene-bg-top: #101a2a;
  --scene-bg-mid: #17243a;
  --scene-bg-bottom: #0d1321;
  --scene-orb-a: rgba(117, 216, 255, 0.22);
  --scene-orb-b: rgba(255, 210, 122, 0.12);
  --scene-orb-c: rgba(215, 238, 248, 0.16);
  --scene-card-tint: rgba(117, 216, 255, 0.1);
  --scene-pill-bg: rgba(35, 54, 75, 0.68);
  --scene-card-border: rgba(215, 238, 248, 0.16);
  --scene-stage-shadow: 0 28rpx 84rpx rgba(5, 9, 18, 0.42);
  --scene-highlight: rgba(117, 216, 255, 0.16);
  --scene-highlight-soft: rgba(255, 255, 255, 0.12);
}

.theme-midnight.scene-newyear {
  --accent-ink: #ffd277;
}

.scene-fx {
  z-index: 2;
  width: 120rpx;
  height: 120rpx;
  border-radius: 999rpx;
  background: transparent;
  box-shadow: none;
  opacity: var(--scene-particle-opacity);
  pointer-events: none;
  filter: blur(0);
  --scene-fx-rotate: 0deg;
  animation: scene-float 12s var(--apple-ease) infinite alternate;
}

.fx-top-left { top: 120rpx; left: 24rpx; }
.fx-top-right { top: 96rpx; right: 20rpx; }
.fx-hero-left { top: 460rpx; left: 4rpx; }
.fx-hero-right { top: 520rpx; right: 8rpx; }
.fx-lower-left { bottom: 320rpx; left: 16rpx; }
.fx-lower-right { bottom: 160rpx; right: 16rpx; }

.fx-orbit {
  width: 22rpx;
  height: 22rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 0 24rpx var(--scene-highlight), 0 0 48rpx rgba(255, 255, 255, 0.22);
  animation-duration: 9s;
}

.fx-heart,
.fx-petal,
.fx-confetti,
.fx-snow,
.fx-firework,
.fx-ribbon,
.fx-bubble,
.fx-glow-bubble,
.fx-frost,
.fx-gold {
  background: transparent;
}

.fx-heart {
  --scene-fx-rotate: 45deg;
  width: 24rpx;
  height: 24rpx;
  border-radius: 8rpx 8rpx 2rpx 2rpx;
  background: rgba(255, 124, 165, 0.88);
  box-shadow: 0 0 20rpx rgba(255, 124, 165, 0.26);
}

.fx-petal {
  --scene-fx-rotate: -18deg;
  width: 16rpx;
  height: 36rpx;
  border-radius: 999rpx 999rpx 999rpx 10rpx;
  background: rgba(233, 112, 143, 0.72);
  box-shadow: 0 0 18rpx rgba(233, 112, 143, 0.24);
}

.fx-confetti {
  --scene-fx-rotate: 18deg;
  width: 18rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(246, 181, 200, 0.94) 0%, rgba(248, 215, 146, 0.92) 100%);
}

.fx-snow {
  width: 12rpx;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 0 20rpx rgba(176, 220, 245, 0.32);
}

.fx-firework {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 210, 119, 0.84);
  box-shadow: 0 0 0 10rpx rgba(255, 139, 168, 0.06), 0 0 24rpx rgba(255, 210, 119, 0.28);
}

.fx-ribbon {
  --scene-fx-rotate: 12deg;
  width: 22rpx;
  height: 60rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(255, 229, 182, 0.94) 0%, rgba(241, 190, 123, 0.74) 100%);
}

.fx-bubble,
.fx-glow-bubble {
  width: 30rpx;
  height: 30rpx;
  border: 1px solid rgba(255, 255, 255, 0.72);
  background: rgba(255, 255, 255, 0.22);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.42), 0 0 22rpx rgba(117, 216, 255, 0.18);
}

.fx-glow-bubble {
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.48), 0 0 24rpx rgba(238, 159, 192, 0.2);
}

.fx-frost {
  width: 60rpx;
  height: 60rpx;
  border: 1px solid rgba(255, 255, 255, 0.42);
  background: radial-gradient(circle, rgba(255, 255, 255, 0.22) 0%, rgba(215, 238, 248, 0.08) 62%, transparent 100%);
}

.fx-gold {
  width: 18rpx;
  height: 18rpx;
  background: rgba(241, 190, 123, 0.92);
  box-shadow: 0 0 20rpx rgba(241, 190, 123, 0.3);
}

@keyframes scene-float {
  0% { transform: translate3d(0, 0, 0) scale(0.92) rotate(var(--scene-fx-rotate)); }
  50% { transform: translate3d(12rpx, -22rpx, 0) scale(1.04) rotate(var(--scene-fx-rotate)); }
  100% { transform: translate3d(-8rpx, 10rpx, 0) scale(0.96) rotate(var(--scene-fx-rotate)); }
}

@keyframes fluent-flow {
  0% { transform: translate3d(0, 0, 0) scale(1) rotate(0deg); }
  26% { transform: translate3d(30rpx, -36rpx, 0) scale(1.08) rotate(5deg); }
  58% { transform: translate3d(-26rpx, 40rpx, 0) scale(0.94) rotate(-4deg); }
  100% { transform: translate3d(22rpx, -18rpx, 0) scale(1.05) rotate(4deg); }
}

.glass-card {
  position: relative;
  z-index: 10;
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  backdrop-filter: blur(30px) saturate(138%);
  -webkit-backdrop-filter: blur(30px) saturate(138%);
  border-radius: 44rpx;
  box-shadow: var(--shadow-glass);
  overflow: hidden;
  transition: transform 0.4s var(--apple-ease), box-shadow 0.4s var(--apple-ease);
  will-change: transform;
}

.float-subtle {
  animation: float-subtle 8.8s ease-in-out infinite alternate;
}

@keyframes float-subtle {
  0% { transform: translate3d(0, 0, 0); }
  100% { transform: translate3d(0, -18rpx, 0); }
}

.glass-card::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--glass-border-highlight), transparent);
  z-index: 1;
}

.animate-enter {
  animation: fade-in-up 0.9s var(--fluent-ease) both;
}
.delay-1 { animation-delay: 0.1s; }
.delay-2 { animation-delay: 0.2s; }
.delay-3 { animation-delay: 0.3s; }
.delay-4 { animation-delay: 0.4s; }

@keyframes fade-in-up {
  0% {
    opacity: 0;
    transform: translateY(40px) scale(0.98);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.container {
  position: relative;
  z-index: 10;
  padding: 40rpx 32rpx;
}

.title-primary {
  font-size: 68rpx;
  font-weight: 800;
  color: var(--ink-primary);
  letter-spacing: -0.04em;
}

.title-secondary {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink-primary);
  letter-spacing: -0.02em;
}

.text-gradient {
  background: linear-gradient(120deg, var(--neon-primary) 0%, var(--neon-accent) 48%, var(--neon-secondary) 100%);
  background-size: 250% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: text-shine 9.8s linear infinite;
}

@keyframes text-shine {
  to { background-position: 220% center; }
}

.text-muted {
  color: var(--ink-secondary);
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 400;
}

.btn-row {
  display: flex;
  gap: 24rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 46rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0;
  border: none;
  transition: all 0.28s var(--apple-ease);
  padding: 0 36rpx;
}

.btn::after {
  display: none;
}

.btn:active {
  transform: scale(0.98);
  opacity: 0.88;
}

.btn-neon {
  background: linear-gradient(135deg, rgba(245, 188, 208, 0.96) 0%, rgba(244, 210, 180, 0.96) 100%);
  color: #523f55;
  box-shadow: 0 10px 20px rgba(243, 154, 181, 0.18);
}

.theme-midnight .btn-neon {
  background: linear-gradient(135deg, rgba(255, 120, 173, 0.94) 0%, rgba(255, 210, 122, 0.9) 100%);
  color: #22162b;
  box-shadow: 0 12px 24px rgba(255, 120, 173, 0.22);
}

.btn-glass {
  background: var(--glass-quiet-bg);
  border: 1px solid var(--glass-border);
  color: var(--ink-primary);
  backdrop-filter: blur(16px);
}

.flex-1 {
  flex: 1;
}

.glass-tag {
  padding: 10rpx 22rpx;
  border-radius: 38rpx;
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  color: var(--ink-primary);
  font-size: 22rpx;
  font-weight: 500;
  backdrop-filter: blur(8px);
  box-shadow: var(--shadow-soft);
}

.empty-glass {
  padding: 60rpx 40rpx;
  text-align: center;
  border: 1px dashed var(--soft-divider);
  border-radius: 32rpx;
  color: var(--ink-secondary);
  font-size: 28rpx;
  line-height: 1.65;
  background: var(--empty-state-bg);
}

.gradient-border-wrap {
  position: relative;
  border-radius: 46rpx;
  padding: 2px;
  background: linear-gradient(135deg, rgba(255, 220, 232, 0.78), rgba(244, 204, 174, 0.72), rgba(220, 239, 247, 0.78));
  background-size: 220% 220%;
  animation: border-flow 13s ease infinite alternate;
  box-shadow: 0 8px 18px rgba(232, 205, 215, 0.1), 0 0 0 1px rgba(255, 255, 255, 0.18);
}

.theme-midnight .gradient-border-wrap {
  background: linear-gradient(135deg, rgba(255, 120, 173, 0.52), rgba(255, 210, 122, 0.42), rgba(117, 216, 255, 0.48));
  box-shadow: 0 10px 24px rgba(5, 4, 18, 0.22), 0 0 0 1px rgba(255, 255, 255, 0.08);
}

@keyframes border-flow {
  0% { background-position: 0% 50%; }
  100% { background-position: 100% 50%; }
}

.gradient-border-wrap > .glass-card {
  border: none;
  height: 100%;
  border-radius: 44rpx;
}

@media (prefers-reduced-motion: reduce) {
  .ambient-orb,
  .scene-fx,
  .float-subtle,
  .animate-enter,
  .text-gradient,
  .gradient-border-wrap,
  .neon-spark,
  .hero-glow,
  .hero-stage-aura,
  .hero-stage-wrap::before,
  .hero-timer-card::after,
  .hero-milestone-pill-dot,
  .lower-memory-breathe,
  .wall-composer-glow,
  .wall-composer-breathe {
    animation: none !important;
    transition: none !important;
  }
}