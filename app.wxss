/* app.wxss - Fresh glass light theme */

page {
  background: #fffaf7;
  color: #463746;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Icons", "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;

  --bg-base: #fffaf7;
  --ink-primary: #463746;
  --ink-secondary: #665468;
  --ink-tertiary: #7f7184;
  --ink-soft: rgba(102, 84, 104, 0.78);
  --accent-ink: #b45e82;
  --display-font: Georgia, "Times New Roman", "Songti SC", serif;

  --neon-primary: #ee9fb8;
  --neon-secondary: #95c7de;
  --neon-accent: #efbf9e;

  --glass-bg: rgba(255, 255, 255, 0.68);
  --glass-quiet-bg: rgba(255, 255, 255, 0.48);
  --glass-strong-bg: rgba(255, 255, 255, 0.78);
  --glass-border: rgba(255, 255, 255, 0.82);
  --glass-border-highlight: rgba(255, 255, 255, 0.94);
  --soft-divider: rgba(165, 137, 154, 0.28);
  --empty-state-bg: rgba(255, 255, 255, 0.46);

  --apple-ease: cubic-bezier(0.25, 1, 0.5, 1);
  --fluent-ease: cubic-bezier(0.16, 1, 0.3, 1);

  --glow-primary: 0 0 24px rgba(243, 154, 181, 0.16);
  --shadow-glass: 0 14px 32px rgba(214, 188, 205, 0.2);
  --shadow-soft: 0 10rpx 28rpx rgba(214, 188, 205, 0.16);

  background:
    radial-gradient(circle at 12% 12%, rgba(243, 154, 181, 0.24), transparent 34%),
    radial-gradient(circle at 88% 18%, rgba(142, 202, 230, 0.22), transparent 30%),
    radial-gradient(circle at 50% 100%, rgba(247, 199, 166, 0.22), transparent 34%),
    linear-gradient(180deg, #fffaf7 0%, #fffefb 42%, #fdf7f5 100%);
}

@media (prefers-color-scheme: dark) {
  .page {
    --bg-base: #151327;
    --ink-primary: #fff4fb;
    --ink-secondary: #e4d7ea;
    --ink-tertiary: #bcaecb;
    --ink-soft: rgba(228, 215, 234, 0.78);
    --accent-ink: #ff9ec6;
    --neon-primary: #ff78ad;
    --neon-secondary: #75d8ff;
    --neon-accent: #ffd27a;
    --glass-bg: rgba(42, 34, 64, 0.66);
    --glass-quiet-bg: rgba(46, 38, 70, 0.5);
    --glass-strong-bg: rgba(58, 47, 82, 0.78);
    --glass-border: rgba(255, 255, 255, 0.14);
    --glass-border-highlight: rgba(255, 255, 255, 0.26);
    --soft-divider: rgba(255, 235, 249, 0.18);
    --empty-state-bg: rgba(255, 255, 255, 0.08);
    --glow-primary: 0 0 32px rgba(255, 120, 173, 0.28);
    --shadow-glass: 0 18px 38px rgba(5, 4, 18, 0.34);
    --shadow-soft: 0 12rpx 30rpx rgba(5, 4, 18, 0.26);
    background:
      radial-gradient(circle at 12% 8%, rgba(255, 120, 173, 0.3), transparent 34%),
      radial-gradient(circle at 86% 18%, rgba(117, 216, 255, 0.24), transparent 32%),
      radial-gradient(circle at 50% 100%, rgba(255, 210, 122, 0.16), transparent 34%),
      linear-gradient(180deg, #171429 0%, #201936 46%, #120f20 100%);
  }

  .page.theme-blush {
    background:
      radial-gradient(circle at 12% 8%, rgba(255, 120, 173, 0.3), transparent 34%),
      radial-gradient(circle at 86% 18%, rgba(117, 216, 255, 0.24), transparent 32%),
      radial-gradient(circle at 50% 100%, rgba(255, 210, 122, 0.16), transparent 34%),
      linear-gradient(180deg, #171429 0%, #201936 46%, #120f20 100%);
  }

  .ambient-orb {
    opacity: 0.46;
    mix-blend-mode: screen;
  }

  .btn-neon {
    background: linear-gradient(135deg, rgba(255, 120, 173, 0.94) 0%, rgba(255, 210, 122, 0.9) 100%);
    color: #22162b;
    box-shadow: 0 12px 24px rgba(255, 120, 173, 0.22);
  }

  .gradient-border-wrap {
    background: linear-gradient(135deg, rgba(255, 120, 173, 0.52), rgba(255, 210, 122, 0.42), rgba(117, 216, 255, 0.48));
    box-shadow: 0 10px 24px rgba(5, 4, 18, 0.22), 0 0 0 1px rgba(255, 255, 255, 0.08);
  }
}

.theme-blush {
  --neon-primary: #e994b0;
  --neon-secondary: #edbd9d;
  --neon-accent: #f7d4e1;
  --accent-ink: #b45e82;
  background:
    radial-gradient(circle at top left, rgba(238, 155, 180, 0.26), transparent 34%),
    radial-gradient(circle at bottom right, rgba(247, 195, 161, 0.2), transparent 30%),
    linear-gradient(180deg, #fff8f8 0%, #fffdfb 45%, #fef6f6 100%);
}

.theme-midnight {
  --bg-base: #151327;
  --ink-primary: #fff4fb;
  --ink-secondary: #e4d7ea;
  --ink-tertiary: #bcaecb;
  --ink-soft: rgba(228, 215, 234, 0.78);
  --accent-ink: #ff9ec6;
  --neon-primary: #ff78ad;
  --neon-secondary: #75d8ff;
  --neon-accent: #ffd27a;
  --glass-bg: rgba(42, 34, 64, 0.66);
  --glass-quiet-bg: rgba(46, 38, 70, 0.5);
  --glass-strong-bg: rgba(58, 47, 82, 0.78);
  --glass-border: rgba(255, 255, 255, 0.14);
  --glass-border-highlight: rgba(255, 255, 255, 0.26);
  --soft-divider: rgba(255, 235, 249, 0.18);
  --empty-state-bg: rgba(255, 255, 255, 0.08);
  --glow-primary: 0 0 32px rgba(255, 120, 173, 0.28);
  --shadow-glass: 0 18px 38px rgba(5, 4, 18, 0.34);
  --shadow-soft: 0 12rpx 30rpx rgba(5, 4, 18, 0.26);
  background:
    radial-gradient(circle at 12% 8%, rgba(255, 120, 173, 0.3), transparent 34%),
    radial-gradient(circle at 86% 18%, rgba(117, 216, 255, 0.24), transparent 32%),
    radial-gradient(circle at 50% 100%, rgba(255, 210, 122, 0.16), transparent 34%),
    linear-gradient(180deg, #171429 0%, #201936 46%, #120f20 100%);
}

.ambient-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(132px);
  opacity: 0.5;
  pointer-events: none;
  z-index: 0;
  mix-blend-mode: multiply;
  animation: fluent-flow 18s var(--apple-ease) infinite alternate;
  will-change: transform;
}

.theme-midnight .ambient-orb {
  opacity: 0.46;
  mix-blend-mode: screen;
}

.orb-1 {
  animation-duration: 20s;
}

.orb-2 {
  animation-duration: 24s;
}

.orb-3 {
  animation-duration: 28s;
}

@keyframes fluent-flow {
  0% { transform: translate3d(0, 0, 0) scale(1) rotate(0deg); }
  26% { transform: translate3d(30rpx, -36rpx, 0) scale(1.08) rotate(5deg); }
  58% { transform: translate3d(-26rpx, 40rpx, 0) scale(0.94) rotate(-4deg); }
  100% { transform: translate3d(22rpx, -18rpx, 0) scale(1.05) rotate(4deg); }
}

.glass-card {
  position: relative;
  z-index: 10;
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  backdrop-filter: blur(30px) saturate(138%);
  -webkit-backdrop-filter: blur(30px) saturate(138%);
  border-radius: 44rpx;
  box-shadow: var(--shadow-glass);
  overflow: hidden;
  transition: transform 0.4s var(--apple-ease), box-shadow 0.4s var(--apple-ease);
  will-change: transform;
}

.float-subtle {
  animation: float-subtle 8.8s ease-in-out infinite alternate;
}

@keyframes float-subtle {
  0% { transform: translate3d(0, 0, 0); }
  100% { transform: translate3d(0, -18rpx, 0); }
}

.glass-card::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--glass-border-highlight), transparent);
  z-index: 1;
}

.animate-enter {
  animation: fade-in-up 0.9s var(--fluent-ease) both;
}
.delay-1 { animation-delay: 0.1s; }
.delay-2 { animation-delay: 0.2s; }
.delay-3 { animation-delay: 0.3s; }
.delay-4 { animation-delay: 0.4s; }

@keyframes fade-in-up {
  0% {
    opacity: 0;
    transform: translateY(40px) scale(0.98);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.container {
  position: relative;
  z-index: 10;
  padding: 40rpx 32rpx;
}

.title-primary {
  font-size: 68rpx;
  font-weight: 800;
  color: var(--ink-primary);
  letter-spacing: -0.04em;
}

.title-secondary {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink-primary);
  letter-spacing: -0.02em;
}

.text-gradient {
  background: linear-gradient(120deg, var(--neon-primary) 0%, var(--neon-accent) 48%, var(--neon-secondary) 100%);
  background-size: 250% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: text-shine 9.8s linear infinite;
}

@keyframes text-shine {
  to { background-position: 220% center; }
}

.text-muted {
  color: var(--ink-secondary);
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 400;
}

.btn-row {
  display: flex;
  gap: 24rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 46rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0;
  border: none;
  transition: all 0.28s var(--apple-ease);
  padding: 0 36rpx;
}

.btn::after {
  display: none;
}

.btn:active {
  transform: scale(0.98);
  opacity: 0.88;
}

.btn-neon {
  background: linear-gradient(135deg, rgba(245, 188, 208, 0.96) 0%, rgba(244, 210, 180, 0.96) 100%);
  color: #523f55;
  box-shadow: 0 10px 20px rgba(243, 154, 181, 0.18);
}

.theme-midnight .btn-neon {
  background: linear-gradient(135deg, rgba(255, 120, 173, 0.94) 0%, rgba(255, 210, 122, 0.9) 100%);
  color: #22162b;
  box-shadow: 0 12px 24px rgba(255, 120, 173, 0.22);
}

.btn-glass {
  background: var(--glass-quiet-bg);
  border: 1px solid var(--glass-border);
  color: var(--ink-primary);
  backdrop-filter: blur(16px);
}

.flex-1 {
  flex: 1;
}

.glass-tag {
  padding: 10rpx 22rpx;
  border-radius: 38rpx;
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  color: var(--ink-primary);
  font-size: 22rpx;
  font-weight: 500;
  backdrop-filter: blur(8px);
  box-shadow: var(--shadow-soft);
}

.empty-glass {
  padding: 60rpx 40rpx;
  text-align: center;
  border: 1px dashed var(--soft-divider);
  border-radius: 32rpx;
  color: var(--ink-secondary);
  font-size: 28rpx;
  line-height: 1.65;
  background: var(--empty-state-bg);
}

.gradient-border-wrap {
  position: relative;
  border-radius: 46rpx;
  padding: 2px;
  background: linear-gradient(135deg, rgba(255, 220, 232, 0.78), rgba(244, 204, 174, 0.72), rgba(220, 239, 247, 0.78));
  background-size: 220% 220%;
  animation: border-flow 13s ease infinite alternate;
  box-shadow: 0 8px 18px rgba(232, 205, 215, 0.1), 0 0 0 1px rgba(255, 255, 255, 0.18);
}

.theme-midnight .gradient-border-wrap {
  background: linear-gradient(135deg, rgba(255, 120, 173, 0.52), rgba(255, 210, 122, 0.42), rgba(117, 216, 255, 0.48));
  box-shadow: 0 10px 24px rgba(5, 4, 18, 0.22), 0 0 0 1px rgba(255, 255, 255, 0.08);
}

@keyframes border-flow {
  0% { background-position: 0% 50%; }
  100% { background-position: 100% 50%; }
}

.gradient-border-wrap > .glass-card {
  border: none;
  height: 100%;
  border-radius: 44rpx;
}