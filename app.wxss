  --scene-bg-top: #221731;
  --scene-bg-mid: #171d32;
  --scene-bg-bottom: #110f21;
  --scene-orb-a: rgba(255, 139, 168, 0.3);
  --scene-orb-b: rgba(255, 210, 119, 0.2);
  --scene-orb-c: rgba(133, 215, 255, 0.22);
  --scene-card-tint: rgba(255, 255, 255, 0.08);
  --scene-card-border: rgba(255, 255, 255, 0.16);
  --scene-pill-bg: rgba(51, 37, 78, 0.68);
  --scene-stage-shadow: 0 28rpx 84rpx rgba(9, 8, 20, 0.42);
  --scene-highlight: rgba(255, 210, 119, 0.18);
  --scene-highlight-soft: rgba(255, 255, 255, 0.12);
  --scene-particle-opacity: 0.64;
}

.scene-milestone {
  --neon-primary: #efbf79;
  --neon-secondary: #f3aac1;
  --neon-accent: #ffe1a4;
  --accent-ink: #a8722e;
  --scene-bg-top: #fff9f1;
  --scene-bg-mid: #fffaf6;
  --scene-bg-bottom: #fff3ea;
  --scene-orb-a: rgba(239, 191, 121, 0.26);
  --scene-orb-b: rgba(243, 170, 193, 0.18);
  --scene-orb-c: rgba(255, 225, 164, 0.2);
  --scene-card-tint: rgba(255, 244, 223, 0.28);
  --scene-pill-bg: rgba(255, 247, 231, 0.72);
  --scene-stage-shadow: 0 28rpx 82rpx rgba(239, 191, 121, 0.24);
