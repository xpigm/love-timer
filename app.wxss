/* app.wxss - Fresh glass light theme */

page {
  background: #fffaf7;
  color: #463746;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Icons", "Helvetica Neue", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;

  --bg-base: #fffaf7;
  --ink-primary: #463746;
  --ink-secondary: #665468;
  --ink-tertiary: #7f7184;
  --ink-soft: rgba(102, 84, 104, 0.78);
  --accent-ink: #b45e82;
  --display-font: Georgia, "Times New Roman", "Songti SC", serif;

  --neon-primary: #ee9fb8;
  --neon-secondary: #95c7de;
  --neon-accent: #efbf9e;

  --glass-bg: rgba(255, 255, 255, 0.68);
  --glass-quiet-bg: rgba(255, 255, 255, 0.48);
  --glass-strong-bg: rgba(255, 255, 255, 0.78);
  --glass-border: rgba(255, 255, 255, 0.82);
  --glass-border-highlight: rgba(255, 255, 255, 0.94);
  --soft-divider: rgba(165, 137, 154, 0.28);
  --empty-state-bg: rgba(255, 255, 255, 0.46);

  --scene-bg-top: #fffaf7;
  --scene-bg-mid: #fffefb;
  --scene-bg-bottom: #fdf7f5;
  --scene-orb-a: rgba(243, 154, 181, 0.24);
  --scene-orb-b: rgba(142, 202, 230, 0.22);
  --scene-orb-c: rgba(247, 199, 166, 0.22);
  --scene-card-tint: rgba(255, 248, 250, 0.22);
  --scene-card-border: rgba(255, 255, 255, 0.82);
  --scene-pill-bg: rgba(255, 255, 255, 0.56);
  --scene-stage-shadow: 0 24rpx 66rpx rgba(214, 188, 205, 0.22);
  --scene-highlight: rgba(243, 154, 181, 0.22);
  --scene-highlight-soft: rgba(255, 255, 255, 0.34);
  --scene-particle-opacity: 0.52;

  --apple-ease: cubic-bezier(0.25, 1, 0.5, 1);
  --fluent-ease: cubic-bezier(0.16, 1, 0.3, 1);

  --glow-primary: 0 0 24px rgba(243, 154, 181, 0.16);
  --shadow-glass: 0 14px 32px rgba(214, 188, 205, 0.2);
  --shadow-soft: 0 10rpx 28rpx rgba(214, 188, 205, 0.16);

  background:
    radial-gradient(circle at 12% 12%, var(--scene-orb-a), transparent 34%),
    radial-gradient(circle at 88% 18%, var(--scene-orb-b), transparent 30%),
    radial-gradient(circle at 50% 100%, var(--scene-orb-c), transparent 34%),
    linear-gradient(180deg, var(--scene-bg-top) 0%, var(--scene-bg-mid) 42%, var(--scene-bg-bottom) 100%);
}

.theme-blush {
  --neon-primary: #e994b0;
  --neon-secondary: #edbd9d;
  --neon-accent: #f7d4e1;
  --accent-ink: #b45e82;
  --scene-bg-top: #fff8f8;
  --scene-bg-mid: #fffdfb;
  --scene-bg-bottom: #fef6f6;
  --scene-orb-a: rgba(238, 155, 180, 0.26);
  --scene-orb-b: rgba(233, 189, 157, 0.18);
  --scene-orb-c: rgba(247, 212, 225, 0.2);
  background:
    radial-gradient(circle at top left, var(--scene-orb-a), transparent 34%),
    radial-gradient(circle at bottom right, var(--scene-orb-b), transparent 30%),
    linear-gradient(180deg, var(--scene-bg-top) 0%, var(--scene-bg-mid) 45%, var(--scene-bg-bottom) 100%);
}

.theme-midnight {
  --bg-base: #171429;
  --ink-primary: #fff4fb;
  --ink-secondary: #e6d8e8;
  --ink-tertiary: #b9a9c4;
  --ink-soft: rgba(230, 216, 232, 0.78);
  --accent-ink: #ff9ec6;
  --neon-primary: #ff78ad;
  --neon-secondary: #75d8ff;
  --neon-accent: #ffd27a;
  --glass-bg: rgba(45, 35, 66, 0.7);
  --glass-quiet-bg: rgba(38, 30, 58, 0.58);
  --glass-strong-bg: rgba(58, 47, 82, 0.78);
  --glass-border: rgba(255, 235, 249, 0.14);
  --glass-border-highlight: rgba(255, 255, 255, 0.22);
  --soft-divider: rgba(255, 235, 249, 0.16);
  --empty-state-bg: rgba(255, 255, 255, 0.07);
  --scene-bg-top: #171429;
  --scene-bg-mid: #201936;
  --scene-bg-bottom: #120f20;
  --scene-orb-a: rgba(255, 120, 173, 0.3);
  --scene-orb-b: rgba(117, 216, 255, 0.24);
  --scene-orb-c: rgba(255, 210, 122, 0.16);
  --scene-card-tint: rgba(255, 158, 198, 0.11);
  --scene-card-border: rgba(255, 235, 249, 0.15);
  --scene-pill-bg: rgba(58, 47, 82, 0.68);
  --scene-stage-shadow: 0 24rpx 72rpx rgba(5, 4, 18, 0.38);
  --scene-highlight: rgba(255, 120, 173, 0.2);
  --scene-highlight-soft: rgba(255, 255, 255, 0.12);
  --scene-particle-opacity: 0.58;
  --glow-primary: 0 0 32px rgba(255, 120, 173, 0.24);
  --shadow-glass: 0 18px 38px rgba(5, 4, 18, 0.34);
  --shadow-soft: 0 12rpx 30rpx rgba(5, 4, 18, 0.28);
  background:
    radial-gradient(circle at 12% 8%, var(--scene-orb-a), transparent 34%),
    radial-gradient(circle at 86% 18%, var(--scene-orb-b), transparent 32%),
    radial-gradient(circle at 50% 100%, var(--scene-orb-c), transparent 34%),
    linear-gradient(180deg, var(--scene-bg-top) 0%, var(--scene-bg-mid) 46%, var(--scene-bg-bottom) 100%);
}

.ambient-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(132px);
  opacity: 0.5;
  pointer-events: none;
  z-index: 0;
  mix-blend-mode: multiply;
  animation: fluent-flow 18s var(--apple-ease) infinite alternate;
  will-change: transform;
}

.theme-midnight .ambient-orb {
  opacity: 0.46;
  mix-blend-mode: screen;
}

.orb-1 {
  animation-duration: 20s;
}

.orb-2 {
  animation-duration: 24s;
}

.orb-3 {
  animation-duration: 28s;
}

.scene-default {
  --scene-stage-shadow: 0 24rpx 66rpx rgba(214, 188, 205, 0.22);
}

.scene-anniversary {
  --neon-primary: #f1be7b;
  --neon-secondary: #f0a4bd;
  --neon-accent: #f8dfad;
  --accent-ink: #b27a35;
  --scene-bg-top: #fff8f1;
  --scene-bg-mid: #fffaf5;
  --scene-bg-bottom: #fff3ee;
  --scene-orb-a: rgba(241, 190, 123, 0.24);
  --scene-orb-b: rgba(240, 164, 189, 0.18);
  --scene-orb-c: rgba(248, 223, 173, 0.22);
  --scene-card-tint: rgba(255, 241, 217, 0.26);
  --scene-pill-bg: rgba(255, 247, 231, 0.72);
  --scene-stage-shadow: 0 28rpx 80rpx rgba(221, 183, 119, 0.24);
  --scene-highlight: rgba(241, 190, 123, 0.22);
}

