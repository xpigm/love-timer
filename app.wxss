  --scene-bg-top: #f7fbff;
  --scene-bg-mid: #fbfeff;
  --scene-bg-bottom: #f3f9fc;
  --scene-orb-a: rgba(142, 200, 232, 0.22);
  --scene-orb-b: rgba(245, 195, 117, 0.18);
  --scene-orb-c: rgba(215, 238, 248, 0.24);
  --scene-card-tint: rgba(241, 249, 255, 0.26);
