/* app.wxss - Apple Event / Fluent Design 动效升级版 */

page {
  /* 基础背景色：极光深色底 */
  background: #000000; /* Apple 式纯黑底，对比度更强烈 */
  color: #f8fafc;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Icons", "Helvetica Neue", "PingFang SC", sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

/* 全局变量定义区 */
.page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;

  /* --- 颜色变量 --- */
  --bg-base: #000000;
  --ink-primary: #f8fafc;
  --ink-secondary: rgba(255, 255, 255, 0.6);
  --ink-tertiary: rgba(255, 255, 255, 0.4);

  /* Fluent/Apple 光效颜色 */
  --neon-primary: #5e5ce6;
  --neon-secondary: #ff375f;
  --neon-accent: #64d2ff;

  /* Fluent 玻璃态材质 */
  --glass-bg: rgba(25, 25, 25, 0.4);
  --glass-border: rgba(255, 255, 255, 0.1);
  --glass-border-highlight: rgba(255, 255, 255, 0.2);

  /* Apple/Fluent 缓动曲线 - 极其顺滑 */
  --apple-ease: cubic-bezier(0.25, 1, 0.5, 1);
  --fluent-ease: cubic-bezier(0.16, 1, 0.3, 1);

  /* 发光与阴影 */
  --glow-primary: 0 0 40px rgba(94, 92, 230, 0.4);
  --shadow-glass: 0 20px 40px rgba(0, 0, 0, 0.5);

  /* 背景渐变遮罩 */
  background:
    radial-gradient(ellipse at 20% -20%, rgba(94, 92, 230, 0.2), transparent 50%),
    radial-gradient(ellipse at 80% 120%, rgba(255, 55, 95, 0.15), transparent 50%),
    var(--bg-base);
}

/* 针对不同主题的光影变体 */
.theme-blush {
  --neon-primary: #ff2d55;
  --neon-secondary: #ff9500;
  background:
    radial-gradient(ellipse at top left, rgba(255, 45, 85, 0.15), transparent 60%),
    radial-gradient(ellipse at bottom right, rgba(255, 149, 0, 0.15), transparent 60%),
    var(--bg-base);
}

.theme-ocean {
  --neon-primary: #32ade6;
  --neon-secondary: #30d158;
  background:
    radial-gradient(ellipse at top left, rgba(50, 173, 230, 0.15), transparent 60%),
    radial-gradient(ellipse at bottom right, rgba(48, 209, 88, 0.15), transparent 60%),
    var(--bg-base);
}

/* 苹果风呼吸光晕 (Apple Event 经典背景光流动) */
.ambient-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(100px); /* 加大模糊度，让它像光影而不是实体 */
  opacity: 0.6;
  pointer-events: none;
  z-index: 0;
  mix-blend-mode: screen; /* 叠加模式，光影更加通透 */
  animation: fluent-flow 20s var(--apple-ease) infinite alternate;
  will-change: transform;
}

@keyframes fluent-flow {
  0% { transform: translate(0, 0) scale(1) rotate(0deg); }
  33% { transform: translate(5vw, -5vh) scale(1.1) rotate(10deg); }
  66% { transform: translate(-3vw, 8vh) scale(0.9) rotate(-5deg); }
  100% { transform: translate(2vw, -2vh) scale(1.05) rotate(5deg); }
}

/* Fluent 亚克力/玻璃态核心类 */
.glass-card {
  position: relative;
  z-index: 10;
  background: var(--glass-bg);
  border: 1px solid var(--glass-border);
  backdrop-filter: blur(40px) saturate(180%);
  -webkit-backdrop-filter: blur(40px) saturate(180%);
  border-radius: 44rpx; /* Apple 常用的大圆角 */
  box-shadow: var(--shadow-glass);
  overflow: hidden;
  transition: transform 0.4s var(--apple-ease), box-shadow 0.4s var(--apple-ease);
  will-change: transform;
}

/* 卡片轻微悬浮呼吸感 (用于一些不操作的卡片自我表现) */
.float-subtle {
  animation: float-subtle 8s ease-in-out infinite alternate;
}

@keyframes float-subtle {
  0% { transform: translateY(0); }
  100% { transform: translateY(-8px); }
}

/* 内部高光 - 增强 3D 感 */
.glass-card::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.25), transparent);
  z-index: 1;
}

/* 入场动画类 (Staggered Fade In Up) */
.animate-enter {
  animation: fade-in-up 1.2s var(--fluent-ease) both;
}
.delay-1 { animation-delay: 0.1s; }
.delay-2 { animation-delay: 0.2s; }
.delay-3 { animation-delay: 0.3s; }
.delay-4 { animation-delay: 0.4s; }

@keyframes fade-in-up {
  0% {
    opacity: 0;
    transform: translateY(40px) scale(0.98);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.container {
  position: relative;
  z-index: 10;
  padding: 40rpx 32rpx;
}

/* 字体排版 */
.title-primary {
  font-size: 68rpx;
  font-weight: 800;
  color: var(--ink-primary);
  letter-spacing: -0.04em; /* Apple 标志性紧凑大标题缩进 */
}

.title-secondary {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink-primary);
  letter-spacing: -0.02em;
}

/* 苹果风流光文字 */
.text-gradient {
  background: linear-gradient(120deg, #fff 0%, var(--neon-accent) 50%, var(--neon-primary) 100%);
  background-size: 200% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: text-shine 8s linear infinite;
}

@keyframes text-shine {
  to { background-position: 200% center; }
}

.text-muted {
  color: var(--ink-secondary);
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 400;
}

/* 按钮样式 - Fluent 顺滑交互 */
.btn-row {
  display: flex;
  gap: 24rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0;
  border: none;
  transition: all 0.4s var(--apple-ease);
  padding: 0 40rpx;
}

.btn::after {
  display: none;
}

.btn:active {
  transform: scale(0.96); /* Apple 标志性的按压回弹 */
  opacity: 0.8;
}

/* 霓虹主按钮 */
.btn-neon {
  background: var(--ink-primary);
  color: var(--bg-base); /* Apple 常用白色背景+黑色文字强调按钮 */
  box-shadow: 0 0 30px rgba(255,255,255,0.2);
}

/* 玻璃次级按钮 */
.btn-glass {
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid var(--glass-border);
  color: var(--ink-primary);
  backdrop-filter: blur(20px);
}

.flex-1 {
  flex: 1;
}

/* 标签 */
.glass-tag {
  padding: 10rpx 24rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid var(--glass-border);
  color: var(--ink-primary);
  font-size: 24rpx;
  font-weight: 500;
  backdrop-filter: blur(8px);
}

/* 空状态 */
.empty-glass {
  padding: 60rpx 40rpx;
  text-align: center;
  border: 1px dashed rgba(255,255,255,0.15);
  border-radius: 32rpx;
  color: var(--ink-secondary);
  font-size: 28rpx;
}

/* 动态边框 (Fluent Design 发光边框特效) */
.gradient-border-wrap {
  position: relative;
  border-radius: 46rpx;
  padding: 2px;
  background: linear-gradient(120deg, var(--neon-accent), var(--neon-primary), transparent 40%, transparent 60%, var(--neon-secondary));
  background-size: 200% 200%;
  animation: border-flow 6s ease infinite alternate;
}

@keyframes border-flow {
  0% { background-position: 0% 50%; }
  100% { background-position: 100% 50%; }
}

.gradient-border-wrap > .glass-card {
  border: none;
  height: 100%;
  border-radius: 44rpx;
}
