page {
  background: #f4e2dc;
  color: #281b22;
  font-family: "Avenir Next", "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  --bg-top: #f3ddd6;
  --bg-bottom: #f9eee7;
  --paper-soft: rgba(255, 249, 242, 0.78);
  --paper-solid: #fff7ef;
  --paper-contrast: rgba(255, 244, 237, 0.96);
  --line-soft: rgba(78, 48, 60, 0.14);
  --line-strong: rgba(70, 40, 52, 0.22);
  --ink-strong: #281b22;
  --ink-soft: #7e6772;
  --accent: #dd6f68;
  --accent-deep: #8d3d48;
  --accent-soft: rgba(221, 111, 104, 0.12);
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at top left, rgba(255, 255, 255, 0.52) 0, rgba(255, 255, 255, 0) 28%),
    radial-gradient(circle at 85% 12%, rgba(255, 219, 194, 0.68) 0, rgba(255, 219, 194, 0) 24%),
    linear-gradient(155deg, var(--bg-top) 0%, var(--bg-bottom) 52%, #f7efe9 100%);
}

.theme-blush {
  --bg-top: #f1d3cd;
  --bg-bottom: #f7ebe4;
  --paper-soft: rgba(255, 248, 241, 0.8);
  --paper-solid: #fff7ef;
  --paper-contrast: rgba(255, 241, 235, 0.96);
  --accent: #dd6f68;
  --accent-deep: #944954;
  --accent-soft: rgba(221, 111, 104, 0.12);
}

.theme-ocean {
  --bg-top: #d7ebf2;
  --bg-bottom: #edf8fb;
  --paper-soft: rgba(246, 252, 253, 0.82);
  --paper-solid: #f8feff;
  --paper-contrast: rgba(236, 249, 252, 0.96);
  --accent: #4d95a3;
  --accent-deep: #305866;
  --accent-soft: rgba(77, 149, 163, 0.12);
}

.theme-sunset {
  --bg-top: #eed4bd;
  --bg-bottom: #faf1e7;
  --paper-soft: rgba(255, 250, 244, 0.82);
  --paper-solid: #fffbf4;
  --paper-contrast: rgba(255, 244, 228, 0.96);
  --accent: #d28747;
  --accent-deep: #8b5327;
  --accent-soft: rgba(210, 135, 71, 0.14);
}

.container {
  position: relative;
  z-index: 2;
  padding: 30rpx;
}

.card {
  position: relative;
  overflow: hidden;
  border: 2rpx solid var(--line-soft);
  border-radius: 40rpx;
  background: var(--paper-soft);
  box-shadow: 0 20rpx 60rpx rgba(70, 40, 52, 0.09);
  backdrop-filter: blur(12rpx);
}

.section-title {
  margin-bottom: 18rpx;
  color: var(--ink-strong);
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.section-desc {
  margin-top: 8rpx;
  color: var(--ink-soft);
  font-size: 24rpx;
  line-height: 1.8;
}

.pill {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.32);
  color: var(--accent-deep);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.btn-primary,
.btn-secondary,
.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: 0;
}

.btn-primary {
  background: linear-gradient(135deg, var(--accent) 0%, #f2ae72 100%);
  color: #ffffff;
  box-shadow: 0 18rpx 36rpx rgba(141, 61, 72, 0.2);
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.58);
  color: var(--ink-strong);
  border: 2rpx solid rgba(70, 40, 52, 0.08);
}

.btn-ghost {
  background: var(--accent-soft);
  color: var(--accent-deep);
}

button::after {
  border: 0;
}

.field-card {
  padding: 26rpx;
}

.field-label {
  margin-bottom: 14rpx;
  color: var(--accent-deep);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.text-input,
.text-area,
.picker-box {
  width: 100%;
  border-radius: 28rpx;
  background: var(--paper-solid);
  border: 2rpx solid var(--line-soft);
  color: var(--ink-strong);
  font-size: 28rpx;
}

.text-input,
.picker-box {
  min-height: 92rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
}

.text-area {
  min-height: 220rpx;
  padding: 22rpx 24rpx;
  line-height: 1.8;
}

.muted {
  color: var(--ink-soft);
}

.empty-state {
  padding: 42rpx 30rpx;
  border: 2rpx dashed var(--line-soft);
  border-radius: 36rpx;
  background: rgba(255, 249, 242, 0.56);
  color: var(--ink-soft);
  line-height: 1.8;
  text-align: center;
}
